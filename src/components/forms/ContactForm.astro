---
// F2 contact form, ported verbatim from discovery/archive/legacy-site/contact/index.html. Handled by the contact-form script (ported with the page).
---
<form data-uwc-form="contact">
  <div class="grid grid-cols-1 gap-x-5 sm:grid-cols-2">
    <fieldset class="fieldset min-w-0 mb-[18px]">
      <label class="label gap-1 whitespace-normal font-bold uppercase tracking-wider text-base-content" for="contact-name">Your name <span class="text-error">*</span></label>
      <input type="text" id="contact-name" name="name" class="input validator w-full h-auto min-h-[46px] text-sm" required autocomplete="name">
    </fieldset>
    <fieldset class="fieldset min-w-0 mb-[18px]">
      <label class="label gap-1 whitespace-normal font-bold uppercase tracking-wider text-base-content" for="contact-email">Email <span class="text-error">*</span></label>
      <input type="email" id="contact-email" name="email" class="input validator w-full h-auto min-h-[46px] text-sm" required autocomplete="email">
    </fieldset>
  </div>
  <div class="grid grid-cols-1 gap-x-5 sm:grid-cols-2">
    <fieldset class="fieldset min-w-0 mb-[18px]">
      <label class="label gap-1 whitespace-normal font-bold uppercase tracking-wider text-base-content" for="contact-phone">Phone <span class="font-normal normal-case tracking-normal text-base-content/60">(optional)</span></label>
      <input type="tel" id="contact-phone" name="phone" class="input w-full h-auto min-h-[46px] text-sm" autocomplete="tel">
    </fieldset>
    <fieldset class="fieldset min-w-0 mb-[18px]">
      <label class="label gap-1 whitespace-normal font-bold uppercase tracking-wider text-base-content" for="contact-reason">What is this about? <span class="text-error">*</span></label>
      <select id="contact-reason" name="reason" class="select validator w-full h-auto min-h-[46px] text-sm" required>
        <option value="" disabled selected>Choose one...</option>
        <option value="trial_or_schedule">Trial pass or schedule</option>
        <option value="tuition_billing">Tuition or billing</option>
        <option value="corporate_clinic">Corporate or team clinic</option>
        <option value="sponsorship">Sponsorship or partnership</option>
        <option value="affiliate">Affiliate or coach partnership</option>
        <option value="media_press">Media or press</option>
        <option value="other">Something else</option>
      </select>
    </fieldset>
  </div>
  <fieldset class="fieldset min-w-0 mb-[18px]">
    <label class="label gap-1 whitespace-normal font-bold uppercase tracking-wider text-base-content" for="contact-message">Message <span class="text-error">*</span></label>
    <textarea id="contact-message" name="message" class="textarea validator w-full min-h-[140px] resize-y text-sm leading-relaxed" required></textarea>
  </fieldset>
  <div class="mt-7">
    <button type="submit" class="btn btn-primary btn-block">Send message</button>
    <p class="form-status alert alert-error alert-soft mt-3 text-sm font-bold" role="status" hidden></p>
  </div>
</form>
