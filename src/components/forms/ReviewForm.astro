---
// F7 review form, ported verbatim from discovery/archive/legacy-site/reviews/index.html. The `review` endpoint is wired by assets/js/uwc-attribution.js.
---
<form novalidate data-uwc-form="review">

            <!-- Overall rating. Stars keep the star-btn / active / hover hooks used by ReviewsScript. -->
            <fieldset class="fieldset min-w-0 mb-[18px]">
              <legend class="fieldset-legend font-bold uppercase tracking-wider">Overall Rating <span class="text-error">*</span></legend>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
                <div class="flex gap-1" id="star-selector" role="radiogroup" aria-label="Star Rating">
                  <button type="button" class="star-btn btn btn-ghost btn-square size-11 text-[1.6rem] leading-none font-normal text-neutral transition-transform hover:scale-[1.08] hover:bg-transparent [&.active]:text-accent [&.hover]:text-accent active" data-value="1" aria-label="1 star">★</button>
                  <button type="button" class="star-btn btn btn-ghost btn-square size-11 text-[1.6rem] leading-none font-normal text-neutral transition-transform hover:scale-[1.08] hover:bg-transparent [&.active]:text-accent [&.hover]:text-accent active" data-value="2" aria-label="2 stars">★</button>
                  <button type="button" class="star-btn btn btn-ghost btn-square size-11 text-[1.6rem] leading-none font-normal text-neutral transition-transform hover:scale-[1.08] hover:bg-transparent [&.active]:text-accent [&.hover]:text-accent active" data-value="3" aria-label="3 stars">★</button>
                  <button type="button" class="star-btn btn btn-ghost btn-square size-11 text-[1.6rem] leading-none font-normal text-neutral transition-transform hover:scale-[1.08] hover:bg-transparent [&.active]:text-accent [&.hover]:text-accent active" data-value="4" aria-label="4 stars">★</button>
                  <button type="button" class="star-btn btn btn-ghost btn-square size-11 text-[1.6rem] leading-none font-normal text-neutral transition-transform hover:scale-[1.08] hover:bg-transparent [&.active]:text-accent [&.hover]:text-accent active" data-value="5" aria-label="5 stars">★</button>
                </div>
                <span class="text-sm font-bold text-base-content" id="star-label">5.0 / 5.0 (Exceptional)</span>
              </div>
              <input type="hidden" name="rating" id="rating-input" value="5">
            </fieldset>

            <!-- Name and Perspective Inputs -->
            <div class="grid grid-cols-1 gap-x-5 sm:grid-cols-2">

              <fieldset class="fieldset min-w-0 mb-[18px]">
                <label class="label whitespace-normal font-bold uppercase tracking-wider text-base-content" for="author-name">Your Full Name or Mat Handle <span class="text-error">*</span></label>
                <input type="text" id="author-name" name="author" class="input validator w-full h-auto min-h-[46px] text-sm" placeholder="e.g. David Johnson or Sarah (Mom of Alex)" required autocomplete="name">
                <p class="label whitespace-normal">Displayed next to your testimonial</p>
              </fieldset>

              <fieldset class="fieldset min-w-0 mb-[18px]">
                <label class="label whitespace-normal font-bold uppercase tracking-wider text-base-content" for="athlete-perspective">Your Role / Perspective <span class="text-error">*</span></label>
                <select id="athlete-perspective" name="perspective" class="select validator w-full h-auto min-h-[46px] text-sm" required>
                  <option value="Youth Parent">Parent of Youth Wrestler</option>
                  <option value="Scholastic Athlete">High School / Scholastic Competitor</option>
                  <option value="Adult Grappler">Adult Grappler / Wrestle-Jitsu / BJJ</option>
                  <option value="Visiting Athlete">Visiting Competitor / Out-of-State Drop-In</option>
                  <option value="Community Supporter">Community Member / Friend of UWC</option>
                </select>
                <p class="label whitespace-normal">Helps route your testimonial to relevant families</p>
              </fieldset>

            </div>

            <!-- Longform Review Text -->
            <fieldset class="fieldset min-w-0 mb-[18px]">
              <label class="label whitespace-normal font-bold uppercase tracking-wider text-base-content" for="review-body">Your Review &amp; Mat Story <span class="text-error">*</span></label>
              <textarea id="review-body" name="review" class="textarea validator w-full min-h-[140px] resize-y text-sm leading-relaxed" placeholder="What has your or your child's experience been like? Consider mentioning coaching attention, technical progress, room cleanliness, or parent hospitality..." required></textarea>
              <p class="label whitespace-normal">Tip: Specific stories about Coach Naweed, technical breakthroughs, or the welcoming culture make the deepest impact on hesitant parents.</p>
            </fieldset>

            <!-- Photos & Attachments Dropzone -->
            <fieldset class="fieldset min-w-0 mb-[18px]">
              <legend class="fieldset-legend font-bold uppercase tracking-wider">Practice or Tournament Photos <span class="font-normal normal-case tracking-normal text-base-content/60">(Optional)</span></legend>
              <div class="relative flex cursor-pointer flex-col items-center gap-1.5 rounded-field border border-dashed border-neutral bg-base-200 px-5 py-7 text-center text-base-content/60 transition-colors hover:border-accent hover:bg-primary/10 focus-visible:border-accent [&.dragover]:border-accent [&.dragover]:bg-primary/10" id="dropzone" role="button" tabindex="0" aria-label="Upload practice or tournament photos">
                <input type="file" id="photo-input" name="photos" accept="image/*" multiple class="pointer-events-none absolute h-px w-px opacity-0">
                <div class="text-[1.4rem]">📷</div>
                <div class="text-sm text-base-content/60">
                  <strong class="text-base-content">Click to upload photos</strong> or drag &amp; drop files here
                </div>
                <p class="label whitespace-normal">Tournament podiums, drilling, team gear photos (PNG, JPG, WebP)</p>
              </div>
              <div class="mt-3 grid grid-cols-[repeat(auto-fill,minmax(96px,1fr))] gap-2.5 empty:hidden" id="preview-grid" aria-live="polite"></div>
            </fieldset>

            <!-- Target Platform Checkboxes -->
            <fieldset class="fieldset min-w-0 mb-[18px]">
              <legend class="fieldset-legend font-bold uppercase tracking-wider">Where Would You Like to Publish This Review?</legend>
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">

                <label class="card card-border flex-row cursor-pointer items-start gap-3 bg-base-200 p-4 has-[:checked]:border-primary/40">
                  <input type="checkbox" name="platform-google" id="check-google" checked class="checkbox checkbox-accent mt-0.5 shrink-0">
                  <div class="min-w-0">
                    <strong class="mb-1 block text-sm text-base-content">Google Business Profile (Highest Impact)</strong>
                    <span class="block text-xs leading-normal text-base-content/60">Powers our 5.0 ★ rating on Google Maps &amp; Local Search in Hayward</span>
                  </div>
                </label>

                <label class="card card-border flex-row cursor-pointer items-start gap-3 bg-base-200 p-4 has-[:checked]:border-primary/40">
                  <input type="checkbox" name="platform-yelp" id="check-yelp" class="checkbox checkbox-accent mt-0.5 shrink-0">
                  <div class="min-w-0">
                    <strong class="mb-1 block text-sm text-base-content">Yelp</strong>
                    <span class="block text-xs leading-normal text-base-content/60">Supports East Bay combat martial arts discoverability</span>
                  </div>
                </label>

                <label class="card card-border flex-row cursor-pointer items-start gap-3 bg-base-200 p-4 has-[:checked]:border-primary/40">
                  <input type="checkbox" name="platform-facebook" id="check-facebook" class="checkbox checkbox-accent mt-0.5 shrink-0">
                  <div class="min-w-0">
                    <strong class="mb-1 block text-sm text-base-content">Facebook Community</strong>
                    <span class="block text-xs leading-normal text-base-content/60">Shares with local grappling &amp; wrestling groups</span>
                  </div>
                </label>

                <label class="card card-border flex-row cursor-pointer items-start gap-3 bg-base-200 p-4 has-[:checked]:border-primary/40">
                  <input type="checkbox" name="platform-website" id="check-website" checked class="checkbox checkbox-accent mt-0.5 shrink-0">
                  <div class="min-w-0">
                    <strong class="mb-1 block text-sm text-base-content">United Wrestling Club Website</strong>
                    <span class="block text-xs leading-normal text-base-content/60">We review every submission before anything goes live on our site</span>
                  </div>
                </label>

              </div>
            </fieldset>

            <div class="mt-7">
              <button type="submit" id="submit-btn" class="btn btn-primary btn-block">
                <span>Post Review &amp; Copy to Clipboard &rarr;</span>
              </button>
            </div>

          </form>
