---
// F1 SMS consent (TCPA). The wording is the exact text from the trial modal until D8 changes it. Edit it here only.
interface Props { idPrefix?: string }
const { idPrefix = 'v01' } = Astro.props;
---
<div class="tcpa-consent-box">
  <label class="tcpa-checkbox-label" for={`${idPrefix}-sms-opt-in`}>
    <input type="checkbox" id={`${idPrefix}-sms-opt-in`} name="sms_opt_in" value="true">
    <span>Text me my 3-Day Mat Pass confirmation, Suite C arrival instructions, and club updates from <strong>United Wrestling Club</strong>.</span>
  </label>
  <div class="tcpa-optout-note">
    Optional. Consent is not a condition of purchase. Msg &amp; data rates may apply. Msg frequency varies (up to 6 msgs/mo). Reply <strong>STOP</strong> to opt out at any time or <strong>HELP</strong> for help.
  </div>
</div>
