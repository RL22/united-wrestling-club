---
// F6 newsletter form, as in the footer. Handled by shell/PageScripts.astro (form[data-uwc-form="newsletter"]).
interface Props { idPrefix?: string }
const { idPrefix = 'v01' } = Astro.props;
---
  <form class="newsletter-form" data-uwc-form="newsletter" novalidate>
    <label class="visually-hidden" for={`${idPrefix}-news-email`}>Email address</label>
    <input type="email" id={`${idPrefix}-news-email`} name="email" class="form-input" placeholder="you@example.com" required autocomplete="email">
    <label class="tcpa-checkbox-label" for={`${idPrefix}-news-consent`}>
      <input type="checkbox" id={`${idPrefix}-news-consent`} name="email_consent" value="yes">
      <span>Email me the Team #513 Mat Report. Unsubscribe anytime.</span>
    </label>
    <button type="submit" class="btn btn-outline btn-block">Subscribe</button>
    <p class="form-status" role="status" hidden></p>
  </form>
