---
// F6 newsletter form, as in the footer. Handled by shell/PageScripts.astro (form[data-uwc-form="newsletter"]).
interface Props { idPrefix?: string }
const { idPrefix = 'v01' } = Astro.props;
---
<form class="mt-3.5 grid gap-2.5" data-uwc-form="newsletter" novalidate>
  <label class="sr-only" for={`${idPrefix}-news-email`}>Email address</label>
  <input type="email" id={`${idPrefix}-news-email`} name="email" class="input validator w-full h-auto min-h-11 text-sm" placeholder="you@example.com" required autocomplete="email">
  <label class="label flex cursor-pointer items-start gap-2.5 whitespace-normal text-sm leading-relaxed text-base-content" for={`${idPrefix}-news-consent`}>
    <input type="checkbox" id={`${idPrefix}-news-consent`} name="email_consent" value="yes" class="checkbox checkbox-accent mt-0.5 shrink-0">
    <span>Email me the Team #513 Mat Report. Unsubscribe anytime.</span>
  </label>
  <button type="submit" class="btn btn-outline btn-block">Subscribe</button>
  <p class="form-status alert alert-error alert-soft text-sm font-bold" role="status" hidden></p>
</form>
