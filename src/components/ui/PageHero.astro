---
// Page hero for interior pages: one H1. `titleBrand` is the red tail of the title.
interface Props { eyebrow?: string; title: string; titleBrand?: string; lead?: string; compact?: boolean; id?: string }
const { eyebrow, title, titleBrand, lead, compact = false, id = 'page-heading' } = Astro.props;
---
<section class:list={['border-b border-neutral bg-base-100 pt-[clamp(96px,12vw,136px)]', compact ? 'pb-[clamp(40px,5vw,64px)]' : 'pb-[clamp(56px,7vw,88px)]']} aria-labelledby={id}>
  <div class="container-uwc">
    {eyebrow && <span data-page-hero="eyebrow" class="mb-3 inline-block text-[0.78rem] font-extrabold uppercase tracking-[0.18em] text-brand-text">{eyebrow}</span>}
    <h1 class="mt-3.5 text-[clamp(2.5rem,6.2vw,4.6rem)] font-black uppercase leading-[1.05] tracking-[-0.02em] text-base-content" id={id}>{title}{titleBrand && <> <span class="text-brand-text">{titleBrand}</span></>}</h1>
    {lead && <p data-page-hero="lead" class="mt-[18px] max-w-[640px] text-[1.05rem] leading-[1.6] text-pretty text-muted">{lead}</p>}
    <slot />
  </div>
</section>
