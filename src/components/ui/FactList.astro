---
// The only way a page shows hours (plan 5.6). Values come from data/facts.ts.
import { facts } from '../../data/facts';
interface Props { show?: 'hours' | 'address' | 'phone' | 'all'; footnote?: boolean }
const { show = 'hours', footnote = true } = Astro.props;
const a = facts.address;
---
{(show === 'hours' || show === 'all') && (
  <div class="flex flex-col gap-1.5 text-muted">
    {facts.hours.rows.map((r) => (
      <div><strong class="text-base-content">{r.days}:</strong> {r.time}{'note' in r && r.note ? ` (${r.note})` : ''}</div>
    ))}
    {footnote && <p class="mt-2 text-[0.8rem] text-muted">{facts.hours.footnote}</p>}
  </div>
)}
{(show === 'address' || show === 'all') && (
  <div class="flex flex-col gap-1.5 text-muted">
    <div>{a.line1}</div>
    <div>{a.city}, {a.region} {a.postal}</div>
  </div>
)}
{(show === 'phone' || show === 'all') && (
  <div><a href={facts.phone.tel} class="link link-hover font-bold text-base-content">{facts.phone.display}</a></div>
)}
