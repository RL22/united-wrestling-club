---
---
  <section class="hero relative flex min-h-[95svh] items-end overflow-hidden border-b border-neutral bg-base-100 pt-[60px] pb-[70px] max-md:h-auto max-md:flex-col max-md:items-stretch max-md:justify-between max-md:p-0">
    <div class="absolute inset-0 z-[1] overflow-hidden">
      <video class="size-full object-cover [object-position:center_36%] [filter:brightness(0.82)_contrast(1.10)_saturate(1.15)] max-md:[filter:brightness(0.78)_contrast(1.12)_saturate(1.15)]" autoplay loop muted playsinline poster="/video_assets/stills_selected/still_44_coach_naweed_mat_command_uwc_banner.jpg">
        <source src="/video_assets/loops/loop_homepage_hero_18s.mp4" type="video/mp4">
        <!-- Fallback Poster Still if video fails -->
        <img src="/video_assets/stills_selected/still_44_coach_naweed_mat_command_uwc_banner.jpg" alt="Coach Naweed directing mat practice under United Wrestling Club banner in Hayward">
      </video>
      <div class="pointer-events-none absolute inset-0 z-[2] bg-[url('/unsplash-grunge-001.jpg')] bg-cover bg-center opacity-5 mix-blend-overlay"></div>
      <div class="absolute inset-0 z-[2] bg-[linear-gradient(90deg,rgba(9,10,13,0.92)_0%,rgba(9,10,13,0.84)_50%,rgba(9,10,13,0.30)_78%,rgba(9,10,13,0.06)_100%),linear-gradient(180deg,rgba(9,10,13,0.45)_0%,transparent_40%,rgba(9,10,13,0.85)_100%)] max-md:bg-[linear-gradient(180deg,rgba(9,10,13,0.50)_0%,rgba(9,10,13,0.12)_18%,rgba(9,10,13,0.02)_45%,rgba(9,10,13,0.40)_55%,rgba(9,10,13,0.78)_66%,rgba(9,10,13,0.95)_100%)]"></div>
    </div>

    <div class="container-uwc relative z-[3] max-md:box-border max-md:flex max-md:min-h-0 max-md:w-full max-md:flex-1 max-md:flex-col max-md:justify-between max-md:pt-5 max-md:pb-[72px]">
      <div class="max-w-[820px] max-md:flex max-md:h-auto max-md:w-full max-md:max-w-full max-md:min-h-0 max-md:flex-1 max-md:flex-col max-md:justify-between max-md:text-left">

        <div class="block max-md:mt-auto max-md:w-full max-md:pt-6">
          <h1 class="mb-[22px] text-[clamp(2.5rem,6.2vw,4.6rem)] leading-[1.05] font-black tracking-[-0.02em] text-text-strong uppercase max-md:mb-3 max-md:text-[clamp(2.1rem,9.2vw,2.75rem)] max-md:[text-shadow:0_2px_10px_rgba(0,0,0,0.85)]">
            Wrestling in Hayward. <br>
            <span class="text-accent [text-shadow:0_2px_10px_rgba(9,10,13,0.85)]">For every stage.</span>
          </h1>

          <p class="mb-9 max-w-[700px] text-[clamp(1.08rem,1.8vw,1.3rem)] leading-[1.6] font-normal text-muted text-pretty max-md:mb-[18px] max-md:max-w-[95%] max-md:text-[clamp(0.92rem,3.8vw,1.04rem)] max-md:leading-[1.55] max-md:text-base-content max-md:[text-shadow:0_2px_8px_rgba(0,0,0,0.9)]">
            A wrestling room in Hayward with named coaches. Try three practices for $15, then $139.99 a month with no contract.
          </p>

          <div class="flex flex-wrap items-center gap-4 max-md:block max-md:w-full max-md:max-w-[340px]">
            <button class="btn btn-primary open-trial-modal max-md:flex max-md:h-[50px] max-md:min-h-[50px] max-md:w-full max-md:items-center max-md:justify-center max-md:px-5 max-md:text-[0.9rem] max-md:font-extrabold max-md:tracking-[0.04em] max-md:shadow-[0_6px_24px_rgba(144,37,36,0.6),0_0_20px_rgba(144,37,36,0.4)]">
              Try three practices for $15
            </button>
          </div>

        </div>
      </div>
    </div>
  </section>
