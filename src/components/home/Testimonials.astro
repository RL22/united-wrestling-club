---
import { reviews } from '../../data/reviews';
const excerpts = [
  'I’ve watched my son grow more confident, disciplined, and mentally stronger every week...',
  'Healthy competition, humble egos, and a room full of experienced grapplers and MMA fighters pushing each other daily.',
  'Everyone was welcoming, supportive, and treated him like part of the team from the very start.',
  'This club has an amazing and positive vibe. It is all about competitive wrestling and the instructors go deep into technique.',
  'Both my boys have blossomed here. No contracts, straightforward pricing, and unmatched coaching.',
  'The caliber of training partners is unbelievable, but zero ego. 10/10 recommendation.',
  'The level of high school freestyle and folkstyle coaching under Coach Naweed and the team is the best in the East Bay.',
  'Immense gratitude for the hospitality and the grueling, technical session.',
];
if (reviews.some((review, index) => !review.body.includes(excerpts[index]))) throw new Error('Testimonial excerpt does not match its source');
---
<section class="testimonials-section section-y border-t border-neutral bg-base-100" id="testimonials" aria-labelledby="testimonials-heading">
  <div class="container-uwc">
    <header class="mx-auto mb-12 max-w-[760px] text-center">
      <span class="mb-3 inline-block text-[0.78rem] font-extrabold uppercase tracking-[0.18em] text-brand-text">COMMUNITY PROOF · REVIEWS FROM THE MAT</span>
      <h2 id="testimonials-heading" class="mb-4 text-[clamp(2rem,3.8vw,2.9rem)] font-black uppercase leading-[1.12] tracking-[-0.01em] text-text-strong">Voices From the Mat. Unfiltered &amp; Earned.</h2>
      <p class="mx-auto max-w-[640px] text-[1.05rem] leading-[1.6] text-muted text-pretty">Hear from parents, competitors, and everyday grinders training in Hayward.</p>
    </header>
    <div class="mb-[18px] flex items-center justify-between gap-4">
      <p class="m-0 text-[0.8rem] font-extrabold tracking-[0.08em] uppercase">Stories from our community</p>
      <div class="flex gap-2" role="group" aria-label="Testimonial controls">
        <button type="button" class="btn btn-square btn-outline size-11 border-neutral bg-base-200 text-xl text-text-strong hover:border-accent focus-visible:border-accent" data-direction="-1" aria-label="Previous testimonials">←</button>
        <button type="button" class="btn btn-square btn-outline size-11 border-neutral bg-base-200 text-xl text-text-strong hover:border-accent focus-visible:border-accent" data-direction="1" aria-label="Next testimonials">→</button>
      </div>
    </div>
    <div class="carousel testimonial-carousel w-full gap-5 pb-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="region" tabindex="0" aria-label="Community testimonials; scroll horizontally to see more">
      {reviews.map((review, index) => (
        <article class="carousel-item card w-[86%] border border-neutral bg-base-200 p-[22px] min-[601px]:w-[44%] min-[601px]:p-[26px] min-[901px]:w-[calc((100%_-_60px)/3.25)]">
          <span class="text-accent" role="img" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}</span>
          <p class="mt-5 mb-6 leading-[1.6] text-text-strong text-pretty">“{excerpts[index]}”</p>
          <div class="mt-auto flex flex-col gap-1 text-[0.85rem] text-muted"><strong class="text-base text-text-strong">{review.author}</strong><span>{review.platform} review</span></div>
        </article>
      ))}
    </div>
    <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4 border-t border-neutral pt-6">
      <a href="https://search.google.com/local/writereview?placeid=ChIJsQd_yMaVj4ARrXw93nb4euo" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Leave a Google Review ↗</a>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.testimonials-section').forEach((section) => {
    const track = section.querySelector<HTMLElement>('.testimonial-carousel');
    section.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) => {
      button.addEventListener('click', () => {
        const card = track?.querySelector<HTMLElement>('.carousel-item');
        if (!track || !card) return;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        track.scrollBy({ left: Number(button.dataset.direction) * (card.offsetWidth + gap), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      });
    });
  });
</script>
