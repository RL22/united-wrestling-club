---
---
  <section class="section-y relative bg-base-100" id="programs">
    <div class="container-uwc">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
        <div>
          <span class="mb-3 inline-block text-[0.78rem] font-extrabold uppercase tracking-[0.18em] text-brand-text">CHAMPIONSHIP CURRICULUM</span>
          <h2 class="mb-4 text-[clamp(2rem,3.8vw,2.9rem)] font-black uppercase leading-[1.12] tracking-[-0.01em] text-text-strong">Programs For Every&nbsp;Stage</h2>
          <p class="max-w-[640px] text-[1.05rem] leading-[1.6] text-muted text-pretty">
            Youth, scholastic and adult classes in Hayward. Pick the program that fits, then try three practices for $15. Our Google rating is 5.0 across 42 reviews, and the Dollamur mats are sanitized twice a day.
          </p>
        </div>
        <a href="/classes/" class="btn btn-outline">Explore all classes</a>
      </div>

      <div class="grid grid-cols-1 gap-4 min-[769px]:grid-cols-2 min-[769px]:gap-6 min-[1221px]:grid-cols-4 min-[1221px]:gap-[22px]">
        <!-- Youth Academy -->
        <div class="card group relative overflow-hidden border border-neutral bg-base-200 transition duration-[250ms] hover:-translate-y-1.5 hover:border-primary/45 hover:shadow-[0_16px_36px_rgba(0,0,0,0.5),0_0_20px_rgba(144,37,36,0.2)]">
          <div class="relative h-[200px] w-full overflow-hidden bg-base-300">
            <span class="badge absolute top-3 left-3 h-auto rounded-field border-white/20 bg-base-100/85 px-2 py-1 text-[0.68rem] font-extrabold tracking-[0.1em] whitespace-nowrap text-text-strong uppercase max-md:px-[7px] max-md:py-[3px] max-md:text-[0.62rem] max-md:tracking-[0.08em]">Kids and youth</span>
            <img class="size-full object-cover [object-position:center_30%] transition-transform duration-[400ms] group-hover:scale-105" src="/video_assets/cards/program-youth.jpg" alt="Youth wrestlers working a stance drill on the UWC red mat">
          </div>
          <div class="card-body grow gap-0 px-5 py-[22px]">
            <h3 class="card-title mb-2 text-[1.22rem] leading-[1.2] font-extrabold text-text-strong uppercase">Youth Wrestling&nbsp;Academy</h3>
            <div class="mb-3 flex items-center gap-2 text-[0.74rem] font-semibold tracking-[0.05em] text-brand-text uppercase"><svg width="12" height="12" viewBox="0 0 512 512" fill="currentColor" class="mr-1 inline-block align-[-1px]"><path d="M256,8C119,8,8,119,8,256S119,504,256,504,504,393,504,256,393,8,256,8Zm92.49,313h0l-20,25a16,16,0,0,1-22.49,2.5h0l-67-49.72a40,40,0,0,1-15-31.23V112a16,16,0,0,1,16-16h32a16,16,0,0,1,16,16V256l58,42.5A16,16,0,0,1,348.49,321Z"/></svg>Mon &amp; Wed • 6:30 – 7:30 PM</div>
            <p class="mb-[22px] grow text-[0.88rem] leading-[1.55] text-muted text-pretty">
              Foundational Folkstyle and Freestyle fundamentals designed to build athletic confidence, spatial awareness, anti-bullying resilience, and respectful sportsmanship.
            </p>
            <div class="flex items-center justify-between border-t border-base-300 pt-4">
              <a href="#trial" class="btn btn-ghost px-0 text-[0.8rem] font-extrabold tracking-[0.08em] text-text-strong uppercase hover:bg-transparent hover:text-brand-text open-trial-modal">Try Youth for $15 &rarr;</a>
            </div>
          </div>
        </div>

        <!-- Varsity High School -->
        <div class="card group relative overflow-hidden border border-neutral bg-base-200 transition duration-[250ms] hover:-translate-y-1.5 hover:border-primary/45 hover:shadow-[0_16px_36px_rgba(0,0,0,0.5),0_0_20px_rgba(144,37,36,0.2)]">
          <div class="relative h-[200px] w-full overflow-hidden bg-base-300">
            <span class="badge absolute top-3 left-3 h-auto rounded-field border-white/20 bg-base-100/85 px-2 py-1 text-[0.68rem] font-extrabold tracking-[0.1em] whitespace-nowrap text-text-strong uppercase max-md:px-[7px] max-md:py-[3px] max-md:text-[0.62rem] max-md:tracking-[0.08em]">Middle and high school</span>
            <img class="size-full object-cover [object-position:center_30%] transition-transform duration-[400ms] group-hover:scale-105" src="/video_assets/cards/program-varsity.jpg" alt="Athlete in an airborne lateral drop during live drilling at UWC">
          </div>
          <div class="card-body grow gap-0 px-5 py-[22px]">
            <h3 class="card-title mb-2 text-[1.22rem] leading-[1.2] font-extrabold text-text-strong uppercase">Varsity &amp; Scholastic&nbsp;Prep</h3>
            <div class="mb-3 flex items-center gap-2 text-[0.74rem] font-semibold tracking-[0.05em] text-brand-text uppercase"><svg width="12" height="12" viewBox="0 0 512 512" fill="currentColor" class="mr-1 inline-block align-[-1px]"><path d="M256,8C119,8,8,119,8,256S119,504,256,504,504,393,504,256,393,8,256,8Zm92.49,313h0l-20,25a16,16,0,0,1-22.49,2.5h0l-67-49.72a40,40,0,0,1-15-31.23V112a16,16,0,0,1,16-16h32a16,16,0,0,1,16,16V256l58,42.5A16,16,0,0,1,348.49,321Z"/></svg>Mon – Thu • 7:30 – 9:00 PM</div>
            <p class="mb-[22px] grow text-[0.88rem] leading-[1.55] text-muted text-pretty">
              High-intensity competition training for East Bay high schoolers pursuing CIF state qualification and collegiate recruitment. Advanced hand-fighting, chained takedowns, and live simulation.
            </p>
            <div class="flex items-center justify-between border-t border-base-300 pt-4">
              <a href="#trial" class="btn btn-ghost px-0 text-[0.8rem] font-extrabold tracking-[0.08em] text-text-strong uppercase hover:bg-transparent hover:text-brand-text open-trial-modal">Try Varsity for $15 &rarr;</a>
            </div>
          </div>
        </div>

        <!-- Adult Wrestle-Jitsu -->
        <div class="card group relative overflow-hidden border border-neutral bg-base-200 transition duration-[250ms] hover:-translate-y-1.5 hover:border-primary/45 hover:shadow-[0_16px_36px_rgba(0,0,0,0.5),0_0_20px_rgba(144,37,36,0.2)]">
          <div class="relative h-[200px] w-full overflow-hidden bg-base-300">
            <span class="badge absolute top-3 left-3 h-auto rounded-field border-white/20 bg-base-100/85 px-2 py-1 text-[0.68rem] font-extrabold tracking-[0.1em] whitespace-nowrap text-text-strong uppercase max-md:px-[7px] max-md:py-[3px] max-md:text-[0.62rem] max-md:tracking-[0.08em]">Adults</span>
            <img class="size-full object-cover [object-position:center_30%] transition-transform duration-[400ms] group-hover:scale-105" src="/video_assets/cards/program-adult.jpg" alt="Two adult grapplers in a collar tie during a UWC adult class">
          </div>
          <div class="card-body grow gap-0 px-5 py-[22px]">
            <h3 class="card-title mb-2 text-[1.22rem] leading-[1.2] font-extrabold text-text-strong uppercase">Adult Wrestling &amp; Wrestle-Jitsu</h3>
            <div class="mb-3 flex items-center gap-2 text-[0.74rem] font-semibold tracking-[0.05em] text-brand-text uppercase"><svg width="12" height="12" viewBox="0 0 512 512" fill="currentColor" class="mr-1 inline-block align-[-1px]"><path d="M256,8C119,8,8,119,8,256S119,504,256,504,504,393,504,256,393,8,256,8Zm92.49,313h0l-20,25a16,16,0,0,1-22.49,2.5h0l-67-49.72a40,40,0,0,1-15-31.23V112a16,16,0,0,1,16-16h32a16,16,0,0,1,16,16V256l58,42.5A16,16,0,0,1,348.49,321Z"/></svg>Mon – Thu • 7:30 – 9:00 PM</div>
            <p class="mb-[22px] grow text-[0.88rem] leading-[1.55] text-muted text-pretty">
              Collegiate wrestling tailored for adults, BJJ practitioners, and combat athletes. Master takedown defense, cage control, and underhooks in an ego-free, high-camaraderie room.
            </p>
            <div class="flex items-center justify-between border-t border-base-300 pt-4">
              <a href="#trial" class="btn btn-ghost px-0 text-[0.8rem] font-extrabold tracking-[0.08em] text-text-strong uppercase hover:bg-transparent hover:text-brand-text open-trial-modal">Try Adult for $15 &rarr;</a>
            </div>
          </div>
        </div>

        <!-- Saturday Open Mat -->
        <div class="card group relative overflow-hidden border border-neutral bg-base-200 transition duration-[250ms] hover:-translate-y-1.5 hover:border-primary/45 hover:shadow-[0_16px_36px_rgba(0,0,0,0.5),0_0_20px_rgba(144,37,36,0.2)]">
          <div class="relative h-[200px] w-full overflow-hidden bg-base-300">
            <span class="badge absolute top-3 left-3 h-auto rounded-field border-white/20 bg-base-100/85 px-2 py-1 text-[0.68rem] font-extrabold tracking-[0.1em] whitespace-nowrap text-text-strong uppercase max-md:px-[7px] max-md:py-[3px] max-md:text-[0.62rem] max-md:tracking-[0.08em]">All Levels</span>
            <img class="size-full object-cover [object-position:center_30%] transition-transform duration-[400ms] group-hover:scale-105" src="/video_assets/cards/program-openmat.jpg" alt="Wrestlers and grapplers in a Saturday open mat session at UWC">
          </div>
          <div class="card-body grow gap-0 px-5 py-[22px]">
            <h3 class="card-title mb-2 text-[1.22rem] leading-[1.2] font-extrabold text-text-strong uppercase">Saturday Open&nbsp;Mat</h3>
            <div class="mb-3 flex items-center gap-2 text-[0.74rem] font-semibold tracking-[0.05em] text-brand-text uppercase"><svg width="12" height="12" viewBox="0 0 512 512" fill="currentColor" class="mr-1 inline-block align-[-1px]"><path d="M256,8C119,8,8,119,8,256S119,504,256,504,504,393,504,256,393,8,256,8Zm92.49,313h0l-20,25a16,16,0,0,1-22.49,2.5h0l-67-49.72a40,40,0,0,1-15-31.23V112a16,16,0,0,1,16-16h32a16,16,0,0,1,16,16V256l58,42.5A16,16,0,0,1,348.49,321Z"/></svg>Saturday • 10:00 AM – 12:00 PM</div>
            <p class="mb-[22px] grow text-[0.88rem] leading-[1.55] text-muted text-pretty">
              Bay Area combat open mat. Live situational sparring, positional rounds, and technique exchanges under coach supervision. $15 mat fee for guests, free for academy members.
            </p>
            <div class="flex items-center justify-between border-t border-base-300 pt-4">
              <a href="#trial" class="btn btn-ghost px-0 text-[0.8rem] font-extrabold tracking-[0.08em] text-text-strong uppercase hover:bg-transparent hover:text-brand-text open-trial-modal">Join Saturday Mat &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
