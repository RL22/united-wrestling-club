<section class="section-y bg-base-100" id="safety">
  <div class="container-uwc">
    <div class="mx-auto max-w-[680px] text-center">
      <span class="mb-3 inline-block text-[0.78rem] font-extrabold uppercase tracking-[0.18em] text-brand-text">SAFETY & INTEGRITY</span>
      <h2 class="mb-4 text-[clamp(2rem,3.8vw,2.9rem)] font-black uppercase leading-[1.12] tracking-[-0.01em] text-text-strong">A Clean, Safe Mat Room in the East&nbsp;Bay</h2>
      <p class="mx-auto max-w-[640px] text-[1.05rem] leading-[1.6] text-muted text-pretty">
        We believe high-level combat athletics require the strictest safety standards, cleanest facilities, and highest coach-to-athlete attention.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-[22px] min-[721px]:grid-cols-2">

      <div class="card border border-neutral bg-base-200 px-6 py-7">
        <div class="mb-4 font-accent text-[2rem] leading-none font-extrabold text-brand-text">02</div>
        <h3 class="mb-2.5 text-[1.15rem] font-extrabold uppercase text-text-strong">3,800 Sq Ft Seamless Dollamur Mats</h3>
        <p class="text-[0.88rem] leading-[1.55] text-muted text-pretty">
          2-inch cross-linked polyethylene shock absorption engineered to cushion high-velocity takedowns and protect developing youth joints and spines.
        </p>
      </div>

      <div class="card border border-neutral bg-base-200 px-6 py-7">
        <div class="mb-4 font-accent text-[2rem] leading-none font-extrabold text-brand-text">04</div>
        <h3 class="mb-2.5 text-[1.15rem] font-extrabold uppercase text-text-strong">Dedicated Parent Lounge</h3>
        <p class="text-[0.88rem] leading-[1.55] text-muted text-pretty">
          Full mat visibility with comfortable seating and Wi-Fi. Parents are always encouraged to watch practices, see their child's progress, and talk with coaches.
        </p>
      </div>
    </div>
  </div>
</section>
