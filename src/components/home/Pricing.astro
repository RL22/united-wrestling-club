---
---
<section class="section-y relative border-y border-neutral bg-base-100" id="pricing">
    <div class="container-uwc">
      <div class="mx-auto max-w-[680px] text-center">
        <span class="mb-3 inline-block text-[0.78rem] font-extrabold uppercase tracking-[0.18em] text-brand-text">TRANSPARENT TUITION</span>
        <h2 class="mb-4 text-[clamp(2rem,3.8vw,2.9rem)] font-black uppercase leading-[1.12] tracking-[-0.01em] text-text-strong">No Contracts. No Hidden&nbsp;Fees.</h2>
        <p class="mx-auto max-w-[640px] text-[1.05rem] leading-[1.6] text-muted text-pretty">
          Month-to-month, no contracts, no initiation fees. Try three practices first, then decide.
        </p>
      </div>

      <div class="mx-auto mt-12 grid w-full grid-cols-1 items-stretch gap-5 min-[769px]:max-w-[480px] min-[961px]:max-w-none min-[961px]:grid-cols-3 min-[961px]:gap-7">
        <!-- 3-Day Mat Pass -->
        <div class="card relative border border-neutral bg-base-200">
          <div class="card-body gap-0 px-[30px] py-9 max-md:px-[18px] max-md:py-7">
            <h3 class="mb-2 text-[1.3rem] font-extrabold uppercase text-text-strong">3-Day Mat Pass</h3>
            <p class="mb-6 min-h-10 text-[0.85rem] text-muted text-pretty">Three practices to see if the room fits. New members only.</p>
            <div class="mb-7 flex items-baseline gap-1 border-b border-base-300 pb-6">
              <span class="font-accent text-[2.8rem] leading-none font-black text-text-strong">$15</span>
              <span class="text-[0.88rem] font-semibold text-muted uppercase">/ 3 practices</span>
            </div>
            <ul class="mb-9 flex grow flex-col gap-3.5">
              <li class="flex items-start gap-2.5 text-[0.9rem] text-base-content">Any age-appropriate class</li>
              <li class="flex items-start gap-2.5 text-[0.9rem] text-base-content">Gear fitting and 1-on-1 check-in with Coach Naweed</li>
            </ul>
            <button class="btn btn-outline open-trial-modal">Try three practices for $15</button>
          </div>
        </div>

        <!-- Monthly Unlimited (Featured) -->
        <div class="card relative border-2 border-primary bg-[linear-gradient(180deg,#181b24_0%,#111319_100%)] shadow-[0_12px_40px_rgba(144,37,36,0.25)] min-[769px]:scale-[1.02]">
          <span class="badge badge-primary absolute -top-3.5 left-1/2 h-auto -translate-x-1/2 px-4 py-[5px] text-[0.72rem] font-extrabold tracking-[0.12em] whitespace-nowrap uppercase">MOST POPULAR</span>
          <div class="card-body gap-0 px-[30px] py-9 max-md:px-[18px] max-md:py-7">
            <h3 class="mb-2 text-[1.3rem] font-extrabold uppercase text-text-strong">Monthly Unlimited</h3>
            <p class="mb-6 min-h-10 text-[0.85rem] text-muted text-pretty">All weekly practices and Saturday open mat.</p>
            <div class="mb-7 flex items-baseline gap-1 border-b border-base-300 pb-6">
              <span class="font-accent text-[2.8rem] leading-none font-black text-text-strong">$139.99</span>
              <span class="text-[0.88rem] font-semibold text-muted uppercase">/&nbsp;Month</span>
            </div>
            <ul class="mb-9 flex grow flex-col gap-3.5">
              <li class="flex items-start gap-2.5 text-[0.9rem] text-base-content">Month-to-month, no contracts</li>
              <li class="flex items-start gap-2.5 text-[0.9rem] text-base-content">No initiation fees</li>
              <li class="flex items-start gap-2.5 text-[0.9rem] text-base-content">Saturday open mat included</li>
            </ul>
            <button class="btn btn-primary open-trial-modal">Start Monthly Membership</button>
          </div>
        </div>

        <!-- Single Mat Drop-In -->
        <div class="card relative border border-neutral bg-base-200">
          <div class="card-body gap-0 px-[30px] py-9 max-md:px-[18px] max-md:py-7">
            <h3 class="mb-2 text-[1.3rem] font-extrabold uppercase text-text-strong">Single Mat Drop-In</h3>
            <p class="mb-6 min-h-10 text-[0.85rem] text-muted text-pretty">For visiting wrestlers and Saturday open mat guests.</p>
            <div class="mb-7 flex items-baseline gap-1 border-b border-base-300 pb-6">
              <span class="font-accent text-[2.8rem] leading-none font-black text-text-strong">$15</span>
              <span class="text-[0.88rem] font-semibold text-muted uppercase">/&nbsp;Visit</span>
            </div>
            <ul class="mb-9 flex grow flex-col gap-3.5">
              <li class="flex items-start gap-2.5 text-[0.9rem] text-base-content">One practice or Saturday open mat</li>
              <li class="flex items-start gap-2.5 text-[0.9rem] text-base-content">Pay at the door</li>
            </ul>
            <button class="btn btn-outline open-trial-modal">Pay Drop-In at Door</button>
          </div>
        </div>
      </div>
    </div>
  </section>
