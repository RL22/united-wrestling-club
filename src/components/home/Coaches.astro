---
---
    <!-- 7. Lineage & Coaching Moat (Textured with Unsplash Grunge) -->
  <section class="lineage-section section-y relative border-y border-neutral bg-surface-0 bg-[linear-gradient(180deg,rgba(11,13,17,0.94)_0%,rgba(11,13,17,0.98)_100%),url('/unsplash-grunge-001.jpg')] bg-cover bg-center" id="coaches">
    <span id="lineage" class="invisible relative -top-[90px] block"></span>
    <div class="container-uwc">
      <div class="grid grid-cols-1 items-center gap-[clamp(40px,6vw,70px)] min-[961px]:grid-cols-[1fr_1.15fr]">
        <div class="relative">
          <div class="overflow-hidden rounded-box border border-neutral bg-base-200 shadow-[0_20px_50px_rgba(0,0,0,0.7)]">
            <img class="h-[520px] w-full object-cover [object-position:center_20%] max-[960px]:h-[380px]" src="/video_assets/stills_selected/still_31_naweed_headshot_united_wall.jpg" alt="Head Wrestling Coach Naweed Zemaryalai under the United Wrestling Club wall in Hayward">
          </div>
        </div>

        <div class="flex flex-col">
          <span class="mb-3 inline-block text-[0.78rem] font-extrabold uppercase tracking-[0.18em] text-brand-text">UNMATCHED PEDIGREE</span>
          <h2 class="mb-4 text-[clamp(2rem,3.8vw,2.9rem)] font-black uppercase leading-[1.12] tracking-[-0.01em] text-text-strong">Coached by Champions, Grounded in&nbsp;Science</h2>
          <p class="max-w-[640px] text-[1.05rem] leading-[1.6] text-muted text-pretty">
            International-grade wrestling forged in Dagestan and collegiate competition.
          </p>

          <div class="mt-9 flex flex-col gap-6">
            <div class="flex gap-5 rounded-field border border-neutral bg-base-200/85 p-5">
              <div>
                <div class="mb-0.5 flex flex-wrap items-center gap-2.5 text-[1.15rem] font-extrabold text-text-strong">
                  Karim Zemaryalai
                  <span class="badge badge-soft badge-accent h-auto rounded-[3px] px-2 py-[3px] text-[0.7rem] font-bold tracking-[0.08em] whitespace-nowrap uppercase"><svg width="11" height="11" viewBox="0 0 512 512" fill="currentColor" class="mr-1 inline-block align-[-1px]"><path d="M223.75 130.75L154.62 15.54A31.997 31.997 0 0 0 127.18 0H16.03C3.08 0-4.5 14.57 2.92 25.18l111.27 158.96c29.72-27.77 67.52-46.83 109.56-53.39zM495.97 0H384.82c-11.24 0-21.66 5.9-27.44 15.54l-69.13 115.21c42.04 6.56 79.84 25.62 109.56 53.38L509.08 25.18C516.5 14.57 508.92 0 495.97 0zM256 160c-97.2 0-176 78.8-176 176s78.8 176 176 176 176-78.8 176-176-78.8-176-176-176zm92.52 157.26l-37.93 36.96 8.97 52.22c1.6 9.36-8.26 16.51-16.65 12.09L256 393.88l-46.9 24.65c-8.4 4.45-18.25-2.74-16.65-12.09l8.97-52.22-37.93-36.96c-6.82-6.64-3.05-18.23 6.35-19.59l52.43-7.64 23.43-47.52c2.11-4.28 6.19-6.39 10.28-6.39 4.11 0 8.22 2.14 10.33 6.39l23.43 47.52 52.43 7.64c9.4 1.36 13.17 12.95 6.35 19.59z"/></svg>Founder & Master Coach</span>
                </div>
                <div class="mt-1.5 text-[0.88rem] leading-[1.5] text-muted">
                  Bronze medalist at the Ali Aliyev Tournament in Makhachkala, Dagestan. Karim brought Dagestani hand-fighting, ankle picks, and relentless mat pressure to Northern California.
                </div>
              </div>
            </div>

            <div class="flex gap-5 rounded-field border border-neutral bg-base-200/85 p-5">
              <div>
                <div class="mb-0.5 flex flex-wrap items-center gap-2.5 text-[1.15rem] font-extrabold text-text-strong">
                  Naweed Zemaryalai
                  <span class="badge badge-soft badge-accent h-auto rounded-[3px] px-2 py-[3px] text-[0.7rem] font-bold tracking-[0.08em] whitespace-nowrap uppercase"><svg width="13" height="13" viewBox="0 0 640 512" fill="currentColor" class="mr-1 inline-block align-[-1px]"><path d="M622.34 153.2L343.4 67.5c-15.2-4.67-31.6-4.67-46.79 0L17.66 153.2c-23.54 7.23-23.54 38.36 0 45.59l48.63 14.94c-10.67 13.19-17.23 29.28-17.88 46.9C38.78 266.15 32 276.11 32 288c0 10.78 5.68 19.85 13.86 25.65L20.33 428.53C18.11 438.52 25.71 448 35.94 448h56.11c10.24 0 17.84-9.48 15.62-19.47L82.14 313.65C90.32 307.85 96 298.78 96 288c0-11.57-6.47-21.25-15.66-26.87.76-15.02 8.44-28.3 20.69-36.72L296.6 284.5c9.06 2.78 26.44 6.25 46.79 0l278.95-85.7c23.55-7.24 23.55-38.36 0-45.6zM352.79 315.09c-28.53 8.76-52.84 3.92-65.59 0l-145.02-44.55L128 384c0 35.35 85.96 64 192 64s192-28.65 192-64l-14.18-113.47-145.03 44.56z"/></svg>Head Coach & Kinesiologist</span>
                </div>
                <div class="mt-1.5 text-[0.88rem] leading-[1.5] text-muted">
                  Son of Karim; former collegiate wrestler at Chabot College and San Francisco State (B.S. in Kinesiology), now a Chabot College coach. Naweed brings biomechanics, injury prevention, and chain wrestling to every practice.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Secondary Coaching Staff Row -->
      <div class="mt-9 border-t border-neutral pt-8">
        <div class="mx-auto mb-7 max-w-[720px] text-center">
          <span class="mb-3 inline-block text-[0.78rem] font-extrabold uppercase tracking-[0.18em] text-brand-text">THE CORNER · EAST BAY COACHING STAFF</span>
          <h3 class="mt-2.5 text-[clamp(1.6rem,3.2vw,2.3rem)] font-black uppercase text-balance text-text-strong">Decades of Mat Mastery Across Every Discipline</h3>
        </div>

        <div class="coach-grid-secondary grid grid-cols-1 gap-5 min-[1101px]:grid-cols-3">
          <!-- Coach 1: Rashad Rahimi -->
          <article class="card group flex-row overflow-hidden border border-neutral bg-base-200 transition duration-200 hover:-translate-y-[3px] hover:border-primary max-[600px]:flex-col">
            <div class="relative flex-[0_0_34%] overflow-hidden bg-base-200 max-[600px]:aspect-[4/3] max-[600px]:flex-none">
              <img class="size-full object-cover [object-position:center_20%] transition-transform duration-300 group-hover:scale-[1.04]" src="/live_site_content/assets/co-founder.jpg" alt="Coach Rashad Rahimi, UWC Co-Founder and Asian Games Silver Medalist" loading="lazy" width="800" height="600">
              <span class="badge absolute bottom-2 left-2 h-auto rounded-[2px] border-white/15 bg-base-100/90 px-2 py-[3px] text-[0.65rem] font-extrabold tracking-[0.08em] text-text-strong uppercase">Asian Games Silver</span>
            </div>
            <div class="flex grow flex-col p-4">
              <span class="mb-1.5 text-[0.72rem] font-extrabold tracking-[0.08em] text-muted uppercase">Co-Founder</span>
              <h4 class="mb-2.5 text-xl font-extrabold text-text-strong uppercase">Rashad Rahimi</h4>
              <p class="mb-0 grow text-[0.82rem] leading-[1.55] text-muted text-pretty">Asian Games silver medalist. Coach Rashad teaches championship footwork and high-level freestyle.</p>
            </div>
          </article>

          <!-- Coach 2: Sandeep Singh Gosal -->
          <article class="card group flex-row overflow-hidden border border-neutral bg-base-200 transition duration-200 hover:-translate-y-[3px] hover:border-primary max-[600px]:flex-col">
            <div class="relative flex-[0_0_34%] overflow-hidden bg-base-200 max-[600px]:aspect-[4/3] max-[600px]:flex-none">
              <img class="size-full object-cover [object-position:center_20%] transition-transform duration-300 group-hover:scale-[1.04]" src="/video_assets/stills_selected/still_09_coach_community_mat.jpg" alt="Coach Sandeep Singh Gosal coaching the youth wrestling tournament squad" loading="lazy" width="800" height="600">
              <span class="badge absolute bottom-2 left-2 h-auto rounded-[2px] border-white/15 bg-base-100/90 px-2 py-[3px] text-[0.65rem] font-extrabold tracking-[0.08em] text-text-strong uppercase">James Logan / Fresno State</span>
            </div>
            <div class="flex grow flex-col p-4">
              <span class="mb-1.5 text-[0.72rem] font-extrabold tracking-[0.08em] text-muted uppercase">Competitive Youth Coach</span>
              <h4 class="mb-2.5 text-xl font-extrabold text-text-strong uppercase">Sandeep Singh Gosal</h4>
              <p class="mb-0 grow text-[0.82rem] leading-[1.55] text-muted text-pretty">James Logan High School wrestler and 2001 California state place winner. Wrestled at Fresno State and earned a B.S. in Business Administration (2007). Works in the semiconductor industry and volunteers as an assistant at Kennedy High School.</p>
            </div>
          </article>

          <!-- Coach 3: Farid Siddiq -->
          <article class="card group flex-row overflow-hidden border border-neutral bg-base-200 transition duration-200 hover:-translate-y-[3px] hover:border-primary max-[600px]:flex-col">
            <div class="relative flex-[0_0_34%] overflow-hidden bg-base-200 max-[600px]:aspect-[4/3] max-[600px]:flex-none">
              <img class="size-full object-cover [object-position:center_20%] transition-transform duration-300 group-hover:scale-[1.04]" src="/video_assets/stills_selected/still_49_sergio_gomez_striking_usa_wrestling_olympic_banner.jpg" alt="Coach Farid Siddiq coaching combat striking mechanics under the USA Wrestling banner" loading="lazy" width="800" height="600">
              <span class="badge absolute bottom-2 left-2 h-auto rounded-[2px] border-white/15 bg-base-100/90 px-2 py-[3px] text-[0.65rem] font-extrabold tracking-[0.08em] text-text-strong uppercase">Striking Specialist</span>
            </div>
            <div class="flex grow flex-col p-4">
              <span class="mb-1.5 text-[0.72rem] font-extrabold tracking-[0.08em] text-muted uppercase">Boxing &amp; Striking Fundamentals</span>
              <h4 class="mb-2.5 text-xl font-extrabold text-text-strong uppercase">Farid Siddiq</h4>
              <p class="mb-0 grow text-[0.82rem] leading-[1.55] text-muted text-pretty">Striking specialist who trains wrestlers in head movement, punching mechanics, distance management, and hip rotation.</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>
