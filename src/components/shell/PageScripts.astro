<script is:inline src="/assets/js/uwc-attribution.js?v=2026-11-05f"></script>

<script is:inline>
    // Trial modal: daisyUI modal, shown by adding modal-open.
    const modal = document.getElementById('trialModal');
    const closeBtn = document.getElementById('modalCloseBtn');
    const doneBtn = document.getElementById('modalDoneBtn');
    const form = document.getElementById('trialForm');
    const formContainer = document.getElementById('modalFormContainer');
    const successState = document.getElementById('modalSuccessState');

    // Mobile drawer state: open means the drawer carries translate-x-0 and visible.
    const mobileMenuToggle = document.getElementById('mobileMenuToggle');
    const mobileNavDrawer = document.getElementById('mobileNavDrawer');
    const mobileNavBackdrop = document.getElementById('mobileNavBackdrop');
    const mobileNavClose = document.getElementById('mobileNavClose');

    function isMobileNavOpen() {
      return Boolean(mobileNavDrawer && mobileNavDrawer.classList.contains('translate-x-0'));
    }

    function setMobileNav(open) {
      if (!mobileNavDrawer) return;
      mobileNavDrawer.classList.toggle('translate-x-0', open);
      mobileNavDrawer.classList.toggle('translate-x-full', !open);
      mobileNavDrawer.classList.toggle('visible', open);
      mobileNavDrawer.classList.toggle('invisible', !open);
      if (mobileNavBackdrop) {
        mobileNavBackdrop.classList.toggle('opacity-100', open);
        mobileNavBackdrop.classList.toggle('opacity-0', !open);
        mobileNavBackdrop.classList.toggle('visible', open);
        mobileNavBackdrop.classList.toggle('invisible', !open);
      }
      if (mobileMenuToggle) mobileMenuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.style.overflow = open ? 'hidden' : '';
    }

    function openModal() {
      if (!modal) return;
      if (isMobileNavOpen()) setMobileNav(false);
      if (window.UWCAttribution) window.UWCAttribution.syncForm();
      modal.classList.add('modal-open');
      document.body.style.overflow = 'hidden';
      const firstInput = form ? form.querySelector('input:not([type="hidden"])') : null;
      if (firstInput) setTimeout(() => firstInput.focus(), 100);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('modal-open');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (formContainer) formContainer.hidden = false;
        if (successState) successState.hidden = true;
        if (form) form.reset();
        if (window.UWCAttribution) window.UWCAttribution.syncForm();
      }, 300);
    }

    document.querySelectorAll('.open-trial-modal').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (doneBtn) doneBtn.addEventListener('click', closeModal);
    if (modal) {
      // Clicks on the daisyUI backdrop or the empty margin around the box close the modal.
      modal.addEventListener('click', (e) => {
        if (e.target === modal || e.target.classList.contains('modal-backdrop')) closeModal();
      });
    }

    if (form) {
      const trialStatus = document.getElementById('v01-trial-status');
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const smsOptInBox = document.getElementById('v01-sms-opt-in');
        const submitBtn = form.querySelector('button[type="submit"]');
        const isOptedIn = Boolean(smsOptInBox && smsOptInBox.checked);
        if (trialStatus) trialStatus.hidden = true;
        if (submitBtn) submitBtn.disabled = true;

        const pending = window.UWCAttribution
          ? window.UWCAttribution.submitLead(form)
          : Promise.reject(new Error('not_connected'));

        pending.then((payload) => {
          window.UWCAttribution.redirectToThankYou(payload, {
            form: 'trial_pass',
            sms: isOptedIn ? 'opted_in' : 'opted_out_or_unchecked'
          });
        }).catch(() => {
          if (trialStatus) {
            trialStatus.textContent = 'We could not send your request. Call (510) 303-4869 and we will reserve your pass.';
            trialStatus.hidden = false;
          }
        }).finally(() => {
          if (submitBtn) submitBtn.disabled = false;
        });
      });
    }

    // Newsletter (footer): explicit consent, unchecked by default.
    document.querySelectorAll('form[data-uwc-form="newsletter"]').forEach((nf) => {
      const status = nf.querySelector('.form-status');
      const say = (msg) => {
        if (!status) return;
        status.textContent = msg;
        status.hidden = false;
      };
      nf.addEventListener('submit', (e) => {
        e.preventDefault();
        const consent = nf.querySelector('input[name="email_consent"]');
        if (consent && !consent.checked) {
          say('Tick the box to get the Mat Report.');
          return;
        }
        const btn = nf.querySelector('button[type="submit"]');
        if (btn) btn.disabled = true;
        window.UWCAttribution.submitLead(nf).then((payload) => {
          nf.reset();
          window.UWCAttribution.redirectToThankYou(payload, { form: 'newsletter' });
        }).catch(() => {
          say('We could not sign you up right now. Call (510) 303-4869 and we will add you.');
        }).finally(() => {
          if (btn) btn.disabled = false;
        });
      });
    });

    // Mobile menu toggle and drawer
    if (mobileMenuToggle) {
      mobileMenuToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        setMobileNav(!isMobileNavOpen());
      });
    }

    if (mobileNavClose) mobileNavClose.addEventListener('click', () => setMobileNav(false));
    if (mobileNavBackdrop) mobileNavBackdrop.addEventListener('click', () => setMobileNav(false));

    // Close mobile nav when clicking any link within it
    if (mobileNavDrawer) {
      mobileNavDrawer.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => setMobileNav(false));
      });
    }

    // Global Escape Key Listener for Modal and Mobile Drawer
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (modal && modal.classList.contains('modal-open')) closeModal();
        if (isMobileNavOpen()) setMobileNav(false);
      }
    });
</script>

<script is:inline>
    (function () {
      var tabs = document.querySelectorAll('.schedule-tab');
      var panels = document.querySelectorAll('.schedule-panel');

      function select(tab) {
        tabs.forEach(function (t) {
          var on = t === tab;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
        });
        panels.forEach(function (p) {
          p.hidden = p.id !== tab.getAttribute('aria-controls');
        });
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () { select(tab); });
        tab.addEventListener('keydown', function (e) {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          var step = e.key === 'ArrowRight' ? 1 : tabs.length - 1;
          var next = tabs[(i + step) % tabs.length];
          next.focus();
          select(next);
        });
      });
    })();
</script>
