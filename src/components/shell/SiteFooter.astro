---
import NewsletterForm from '../forms/NewsletterForm.astro';
import { footerPrograms, footerAcademy, forPage } from '../../data/nav';

interface Props { isHome?: boolean }
const { isHome = true } = Astro.props;
const programs = forPage(footerPrograms, isHome);
const academy = forPage(footerAcademy, isHome);
---

  <footer class="footer bg-[#060709] px-0 pt-[70px] pb-[30px] text-[0.88rem] text-muted" id="visit">
    <div class="container-uwc">
      <div class="mb-[60px] grid grid-cols-1 gap-10 min-[769px]:grid-cols-2 min-[961px]:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
        <div class="min-[769px]:col-start-1 min-[769px]:row-start-1 min-[961px]:col-auto min-[961px]:row-auto">
          <div class="mb-4">
            <picture><source media="(max-width: 768px)" srcset="/assets/logo--uwc-wordmark.svg"><img src="/assets/logo--uwc_wrestlers.svg" alt="United Wrestling Club" class="block h-[52px] w-auto max-w-full max-[480px]:h-11"></picture>
          </div>
          <p class="mb-4 text-[0.85rem] leading-[1.6] text-muted">
            Wrestling and grappling for kids, teens, and adults in Hayward, California.
          </p>
          <div class="text-[0.78rem] font-bold text-accent">
            USA WRESTLING RTC #513 SANCTIONED CLUB
          </div>
          <div class="mt-[18px] flex items-center gap-3">
            <a href="https://instagram.com/uwc_wrestling" target="_blank" class="btn btn-square size-11 min-h-11 border-neutral bg-base-200 text-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-primary hover:bg-primary hover:text-base-content hover:shadow-[0_4px_12px_rgba(144,37,36,0.4)]" aria-label="United Wrestling Club on Instagram">
              <svg width="16" height="16" viewBox="0 0 448 512" fill="currentColor"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/></svg>
            </a>
            <a href="https://www.youtube.com/@UnitedWrestlingClub" target="_blank" class="btn btn-square size-11 min-h-11 border-neutral bg-base-200 text-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-primary hover:bg-primary hover:text-base-content hover:shadow-[0_4px_12px_rgba(144,37,36,0.4)]" aria-label="United Wrestling Club on YouTube">
              <svg width="16" height="16" viewBox="0 0 576 512" fill="currentColor"><path d="M549.655 124.083c-6.281-23.65-24.787-42.276-48.284-48.597C458.781 64 288 64 288 64S117.22 64 74.629 75.486c-23.497 6.322-42.003 24.947-48.284 48.597-11.412 42.867-11.412 132.305-11.412 132.305s0 89.438 11.412 132.305c6.281 23.65 24.787 41.5 48.284 47.821C117.22 448 288 448 288 448s170.78 0 213.371-11.486c23.497-6.321 42.003-24.171 48.284-47.821 11.412-42.867 11.412-132.305 11.412-132.305s0-89.438-11.412-132.305zm-317.51 213.508V175.185l142.739 81.205-142.739 81.201z"/></svg>
            </a>
            <a href="https://facebook.com" target="_blank" class="btn btn-square size-11 min-h-11 border-neutral bg-base-200 text-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-primary hover:bg-primary hover:text-base-content hover:shadow-[0_4px_12px_rgba(144,37,36,0.4)]" aria-label="United Wrestling Club on Facebook">
              <svg width="16" height="16" viewBox="0 0 512 512" fill="currentColor"><path d="M504 256C504 119 393 8 256 8S8 119 8 256c0 123.78 90.69 226.38 209.25 245V327.69h-63V256h63v-54.64c0-62.15 37-96.48 93.67-96.48 27.14 0 55.52 4.84 55.52 4.84v61h-31.28c-30.8 0-40.41 19.12-40.41 38.73V256h68.78l-11 71.69h-57.78V501C413.31 482.38 504 379.78 504 256z"/></svg>
            </a>
          </div>
        </div>

        <div class="min-[769px]:col-start-2 min-[769px]:row-start-1 min-[961px]:col-auto min-[961px]:row-auto">
          <div class="footer-title mb-5 text-[0.82rem] font-extrabold uppercase tracking-[0.12em] text-base-content opacity-100">Team #513 Mat Report</div>
          <p class="mb-4 text-[0.85rem] leading-[1.6] text-muted">Monthly news on events and clinics.</p>
          <NewsletterForm />
        </div>

        <div class="min-[769px]:col-start-1 min-[769px]:row-start-2 min-[961px]:col-auto min-[961px]:row-auto">
          <div class="footer-title mb-5 text-[0.82rem] font-extrabold uppercase tracking-[0.12em] text-base-content opacity-100">Programs</div>
          <ul class="m-0 flex list-none flex-col gap-3 p-0">
            {programs.map((item) => <li><a href={item.href} class="inline-flex min-h-11 items-center py-1 text-muted no-underline transition-colors duration-300 hover:text-base-content">{item.label}</a></li>)}
          </ul>
        </div>

        <div class="min-[769px]:col-start-1 min-[769px]:row-start-3 min-[961px]:col-auto min-[961px]:row-auto">
          <div class="footer-title mb-5 text-[0.82rem] font-extrabold uppercase tracking-[0.12em] text-base-content opacity-100">Academy</div>
          <ul class="m-0 flex list-none flex-col gap-3 p-0">
            {academy.map((item) => <li><a href={item.href} class="inline-flex min-h-11 items-center py-1 text-muted no-underline transition-colors duration-300 hover:text-base-content">{item.label}</a></li>)}
          </ul>
        </div>

        <div class="min-[769px]:col-start-2 min-[769px]:row-start-2 min-[769px]:row-span-2 min-[961px]:col-auto min-[961px]:row-auto min-[961px]:row-span-1">
          <div class="footer-title mb-5 text-[0.82rem] font-extrabold uppercase tracking-[0.12em] text-base-content opacity-100">Hayward Headquarters</div>
          <div class="flex flex-col gap-2.5 leading-normal">
            <div><strong class="text-base-content">United Wrestling Club</strong></div>
            <div>30139 Industrial Pkwy SW Ste C<br>Hayward, CA 94544</div>
            <div class="mt-1.5">
              <a href="tel:5103034869" class="inline-flex min-h-11 items-center py-1 font-bold text-base-content no-underline transition-colors duration-300 hover:text-base-content">(510) 303-4869</a>
            </div>
            <div>
              <a href="mailto:unitedwrestlingclub@gmail.com" class="inline-flex min-h-11 items-center py-1 text-muted no-underline transition-colors duration-300 hover:text-base-content">unitedwrestlingclub@gmail.com</a>
            </div>
            <div class="mt-1.5 text-[0.8rem]">
              Mon–Fri: 6:00 AM – 10:00 PM<br>
              Saturday: 10:00 AM – 12:00 PM<br>
              Sunday: Closed
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-5 border-t border-base-300 pt-[30px] text-[0.78rem]">
        <div>&copy; 2026 United Wrestling Club. All rights reserved. Registered USA Wrestling RTC #513.</div>
        <div>
          Serving Hayward • Union City • Fremont • San Leandro • Castro Valley • Newark, CA
        </div>
      </div>
    </div>
  </footer>
