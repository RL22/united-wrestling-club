---
import FactList from '../../ui/FactList.astro';
import { facts } from '../../../data/facts';
---
<aside class="contact-card" aria-label="Club details">
  <h2 class="contact-card-title">Hayward facility</h2>
  <address class="contact-address">United Wrestling Club</address>
  <FactList show="address" />
  <FactList show="phone" />
  <h3 class="contact-card-subtitle">Hours</h3>
  <FactList show="hours" />
  <p class="contact-line"><a href={facts.address.mapsUrl} target="_blank" rel="noopener noreferrer">Directions on Google Maps &nearr;</a></p>
</aside>
