---
// Shared body for the three wrestling class pages. Copy comes from each page; coaches and trial terms come from data/facts.ts.
import ProgramPage from '../../templates/ProgramPage.astro';
import ClassSection from '../classes-adult/ClassSection.astro';
import RowList from '../classes-adult/RowList.astro';
import { facts } from '../../../data/facts';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
  heading: string;
  lead: string;
  sections: { title: string; body: string }[];
  prices: { label: string; value: string }[];
  coachNames: string[];
  schedule: { program?: string; tag?: string };
  trialProgram: 'youth' | 'varsity' | 'adult';
}
const { title, description, path, eyebrow, heading, lead, sections, prices, coachNames, schedule, trialProgram } = Astro.props;
const coaches = facts.coaches.filter((c) => coachNames.includes(c.name));
const priceRows = [
  ...prices.map((p) => ({ head: p.label, body: p.value })),
  { head: facts.trialPass.name, body: `${facts.trialPass.price}. ${facts.trialPass.blurb}` },
];
---
<ProgramPage title={title} description={description} path={path} eyebrow={eyebrow} heading={heading} lead={lead} schedule={schedule} trialProgram={trialProgram}>
  <ClassSection title="What you work on">
    <RowList items={sections.map((s) => ({ head: s.title, body: s.body }))} />
  </ClassSection>

  <ClassSection title="Coaches">
    <RowList items={coaches.map((c) => ({ head: c.name, body: c.role }))} />
  </ClassSection>

  <ClassSection title="Prices">
    <RowList items={priceRows} />
    <p class="text-muted">{facts.membership.terms} <a href="/pricing/" class="link link-hover text-base-content">View membership pricing</a>.</p>
  </ClassSection>
</ProgramPage>
