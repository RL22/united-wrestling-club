<script is:inline>
    (function () {
      const form = document.getElementById('registerForm');
      if (!form) return;
      const status = document.getElementById('reg-trial-status');
      const success = document.getElementById('reg-success');
      const wiq = document.getElementById('reg-wiq-btn');
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const smsBox = document.getElementById('reg-sms-opt-in');
        const isOptedIn = Boolean(smsBox && smsBox.checked);
        const btn = form.querySelector('button[type="submit"]');
        if (status) status.hidden = true;
        if (btn) btn.disabled = true;
        window.UWCAttribution.submitLead(form).then(() => {
          const row = document.getElementById('reg-sms-status-row');
          if (row) {
            row.innerHTML = isOptedIn
              ? '<strong>SMS Status:</strong> Opted In (Reply STOP anytime to opt out)'
              : '<strong>SMS Status:</strong> Opted Out (No automated texts will be sent)';
          }
          if (wiq) wiq.href = window.UWCAttribution.decorateUrl(wiq.href);
          form.hidden = true;
          if (success) success.hidden = false;
        }).catch(() => {
          if (status) {
            status.textContent = 'We could not send your request. Call (510) 303-4869 for help with your pass.';
            status.hidden = false;
          }
        }).finally(() => {
          if (btn) btn.disabled = false;
        });
      });
    })();

  
</script>
