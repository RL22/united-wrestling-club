<script is:inline>
    (function () {
      const form = document.getElementById('registerForm');
      if (!form) return;
      const status = document.getElementById('reg-trial-status');
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const smsBox = document.getElementById('reg-sms-opt-in');
        const isOptedIn = Boolean(smsBox && smsBox.checked);
        const btn = form.querySelector('button[type="submit"]');
        if (status) status.hidden = true;
        if (btn) btn.disabled = true;
        window.UWCAttribution.submitLead(form).then((payload) => {
          window.UWCAttribution.redirectToThankYou(payload, {
            form: 'trial_pass',
            sms: isOptedIn ? 'opted_in' : 'opted_out_or_unchecked'
          });
        }).catch(() => {
          if (status) {
            status.textContent = 'We could not send your request. Call (510) 303-4869 for help with your pass.';
            status.hidden = false;
          }
        }).finally(() => {
          if (btn) btn.disabled = false;
        });
      });
    })();
</script>
