---
// Native details/summary accordion styled with daisyUI collapse. No JS needed. The first item starts open.
import type { Faq } from '../../../data/faqs';
interface Props { items: Faq[] }
const { items } = Astro.props;
---
<div class="mx-auto flex max-w-[860px] flex-col gap-3">
  {items.map((f, i) => (
    <details class="collapse collapse-arrow rounded-box border border-base-300 bg-base-200" open={i === 0}>
      <summary class="collapse-title py-5 pr-14 pl-6 text-base font-semibold">{f.q}</summary>
      <div class="collapse-content max-w-[68ch] px-6 pb-5 text-[0.94rem] text-base-content/80">{f.a}</div>
    </details>
  ))}
</div>
