---
// Plan rows from discovery/archive/legacy-site/live_site_content/pricing.json (prices and URLs as sourced).
// Rows, not cards: the price and the sign-up action line up in columns on desktop and stack on phones.
import Button from '../../ui/Button.astro';
export type Plan = { name: string; price: string; period: string; schedule: string; featured: boolean; url: string };
interface Props { plans: Plan[] }
const { plans } = Astro.props;
const money = (value: string) => Number(value).toFixed(2);
---
<ul class="mx-auto max-w-[960px] divide-y divide-neutral border-y border-neutral">
  {plans.map((p) => (
    <li class:list={['grid gap-4 border-l-4 py-6 pl-5 min-[960px]:grid-cols-[minmax(0,1fr)_200px_260px] min-[960px]:items-center min-[960px]:gap-10', p.featured ? 'border-primary' : 'border-transparent']}>
      <div class="min-w-0">
        <h3 class="mb-1.5 flex flex-wrap items-center gap-x-3 gap-y-2 text-lg leading-snug font-extrabold uppercase">
          {p.name}
          {p.featured && <span class="badge badge-accent h-auto px-3 py-1 text-xs font-extrabold tracking-[0.12em] uppercase">Featured</span>}
        </h3>
        {p.schedule && <p class="m-0 text-sm text-muted">{p.schedule}</p>}
      </div>
      <div class="flex items-baseline gap-1.5">
        <span class="font-accent text-[2.2rem] leading-none font-black">${money(p.price)}</span>
        <span class="text-sm font-semibold uppercase text-muted">{p.period}</span>
      </div>
      <Button href={p.url} variant={p.featured ? 'primary' : 'outline'} class="min-h-11 w-full min-[960px]:w-auto">Sign up on WrestlingIQ</Button>
    </li>
  ))}
</ul>
