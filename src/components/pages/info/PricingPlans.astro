---
// Plan cards from discovery/archive/legacy-site/live_site_content/pricing.json (prices and URLs as sourced). Card markup follows home/Pricing.astro.
import Button from '../../ui/Button.astro';
export type Plan = { name: string; price: string; period: string; schedule: string; featured: boolean; url: string };
interface Props { plans: Plan[] }
const { plans } = Astro.props;
---
<div class="mx-auto grid max-w-[480px] grid-cols-1 gap-6 min-[960px]:max-w-none min-[960px]:grid-cols-3">
  {plans.map((p) => (
    <div class:list={['card relative flex flex-col rounded-box border border-base-300 bg-base-200 px-[26px] py-8', { 'border-2 border-primary': p.featured }]}>
      {p.featured && <span class="badge badge-accent absolute -top-3.5 left-1/2 h-auto -translate-x-1/2 px-4 py-1 text-xs font-extrabold uppercase tracking-[0.12em] whitespace-nowrap">Featured</span>}
      <h3 class="mb-3.5 text-lg font-extrabold uppercase">{p.name}</h3>
      <div class="mb-3.5 flex items-baseline gap-1.5">
        <span class="font-accent text-[2.4rem] leading-none font-black">${p.price}</span>
        <span class="text-sm font-semibold uppercase text-base-content/70">{p.period}</span>
      </div>
      {p.schedule && <p class="mb-5 grow text-sm text-base-content/70">{p.schedule}</p>}
      <Button href={p.url} variant={p.featured ? 'primary' : 'outline'} block class="mt-auto">Sign up on WrestlingIQ</Button>
    </div>
  ))}
</div>
