---
// Events board, copied from discovery/archive/legacy-site/live_site_content/events.md (D6 pending owner unlock). No forms.
import { events } from './events-data';
---
<section class="section-y" aria-labelledby="kickoff-heading">
  <div class="container-uwc">
    <div class="mx-auto max-w-[900px]">
      <p class="mb-6 text-center font-bold">Competition Season: September 2026 – August 2027</p>
      <div class="card card-border border-base-300 bg-base-200">
        <div class="card-body">
          <span class="badge badge-accent">Season kickoff · October 3, 2026</span>
          <h2 class="card-title text-2xl" id="kickoff-heading">North Coast Grapplers</h2>
          <div class="text-sm text-base-content/70">James Logan High School · Union City, CA</div>
          <div class="card-actions"><a class="btn btn-primary" href="https://trackwrestling.com/registration/TW_Register.jsp?tournamentGroupId=289571132" rel="noopener">Register for the kickoff</a></div>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="section-y bg-base-200" aria-labelledby="req-heading">
  <div class="container-uwc">
    <div class="mx-auto max-w-[900px]">
      <h2 class="mb-5 text-2xl font-bold" id="req-heading">Membership and tournament attire</h2>
      <div class="grid grid-cols-1 gap-4 min-[900px]:grid-cols-3">
        <div class="card card-border border-base-300 bg-base-100">
          <div class="card-body">
            <h3 class="card-title text-lg">USA Wrestling membership</h3>
            <p class="text-sm text-base-content/80">Required for USA Wrestling and CAUSAW events, including SCVWA, MDWA, BAWA, SJWA, and CAUSAW state championships.</p>
            <div class="card-actions"><a class="link link-accent" href="https://www.usawmembership.com/" rel="noopener">Get USA Wrestling membership</a></div>
          </div>
        </div>
        <div class="card card-border border-base-300 bg-base-100">
          <div class="card-body">
            <h3 class="card-title text-lg">SCWAY membership</h3>
            <p class="text-sm text-base-content/80">Required separately for SCWAY events. A USA Wrestling card does not cover SCWAY events.</p>
            <div class="card-actions"><a class="link link-accent" href="https://www.scwaywrestling.org/sign-up" rel="noopener">Get SCWAY membership</a></div>
          </div>
        </div>
        <div class="card card-border border-base-300 bg-base-100">
          <div class="card-body">
            <h3 class="card-title text-lg">Practice attire</h3>
            <p class="text-sm text-base-content/80">Practice: casual workout clothes are fine.</p>
            <p class="text-sm text-base-content/80">Tournaments: wear a UWC warm-up shirt, warm-up shorts, and singlet.</p>
            <p class="text-sm text-base-content/80">Optional: sweatshirts and sweatpants are available at the front desk.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="section-y" aria-labelledby="all-heading">
  <div class="container-uwc">
    <div class="mx-auto max-w-[900px]">
      <h2 class="mb-5 text-2xl font-bold" id="all-heading">2026–2027 tournament schedule</h2>
      <ol class="list" data-event-count={events.length}>
        {events.map((e) => (
          <li class="list-row grid-flow-row grid-cols-1 gap-1 border-t border-base-300 px-0 py-3.5 min-[900px]:grid-cols-[11rem_1fr_15rem] min-[900px]:items-baseline min-[900px]:gap-4" value={e.n}>
            <span class="font-bold">{e.date}</span>
            <span>{e.name}</span>
            <span class="text-sm text-base-content/85">{e.status}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
