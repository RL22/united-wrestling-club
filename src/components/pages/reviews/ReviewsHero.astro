---
import PageHero from '../../ui/PageHero.astro';
import PlatformCards from './PlatformCards.astro';
---
<PageHero
  id="reviews-page-heading"
  eyebrow="Verified Social Proof · Hayward, CA · RTC #513"
  title="United Wrestling Club"
  titleBrand="Reviews"
  lead="5.0 ★ verified reviews from East Bay youth parents, CIF high school competitors, and adult grapplers training on the mat at 30139 Industrial Pkwy SW. Read authentic member experiences or share your story below."
>
  <div class="mt-10 mb-8 flex flex-wrap items-baseline gap-x-4 gap-y-2">
    <span class="font-accent text-[clamp(3.5rem,8vw,5.5rem)] leading-none font-bold text-base-content">5.0</span>
    <span class="text-[1.1rem] font-semibold text-muted">/ 5.0</span>
    <span class="text-xl tracking-[3px] text-accent" aria-label="5.0 out of 5 stars">★★★★★</span>
    <!-- D13 resolved (D26): the owner confirmed the review stats from the Google Business Profile. -->
    <p class="m-0 basis-full text-[0.9rem] text-muted">42+ Verified Reviews Across Platforms</p>
  </div>
  <PlatformCards />
</PageHero>
