---
import SectionHeader from '../../ui/SectionHeader.astro';
import ReviewForm from '../../forms/ReviewForm.astro';
import DispatchModal from './DispatchModal.astro';
import ReviewsScript from './ReviewsScript.astro';
---
<section class="section-y border-t border-border-default bg-base-200" id="review-form" aria-labelledby="submission-heading">
  <div class="container-uwc">
    <div class="card card-border mx-auto max-w-[860px] border-border-default bg-base-100">
      <div class="card-body p-[clamp(24px,4vw,40px)]">
        <SectionHeader
          eyebrow="Share your experience"
          id="submission-heading"
          title="Share Your Experience on the Mat"
          lead="Your review helps other East Bay families, high school wrestlers, and grapplers find their place in our room. Submit below, attach practice or podium photos, and dispatch to Google Maps or Yelp in one click!"
        />
        <ul class="steps steps-vertical mb-10 w-full text-left sm:steps-horizontal" aria-label="How posting works">
          <li class="step step-primary text-sm text-muted"><span class="font-bold text-base-content">Submit here.</span> The club reviews your text before anything goes live.</li>
          <li class="step step-primary text-sm text-muted"><span class="font-bold text-base-content">Paste on the platform.</span> Your text is copied. Open Google, Yelp, or Facebook and paste it.</li>
          <li class="step step-primary text-sm text-muted"><span class="font-bold text-base-content">Post from your account.</span> Each platform asks you to sign in.</li>
        </ul>
        <ReviewForm />
      </div>
    </div>
  </div>
</section>
<DispatchModal />
<ReviewsScript />
