---
import SectionHeader from '../../ui/SectionHeader.astro';
import ReviewForm from '../../forms/ReviewForm.astro';
import DispatchModal from './DispatchModal.astro';
import ReviewsScript from './ReviewsScript.astro';
---
<section class="section-block section-block--raised" id="review-form" aria-labelledby="submission-heading">
  <div class="container">
    <div class="form-card">
      <SectionHeader
        eyebrow="Share your experience"
        id="submission-heading"
        title="Share Your Experience on the Mat"
        lead="Your review helps other East Bay families, high school wrestlers, and grapplers find their place in our room. Submit below, attach practice or podium photos, and dispatch to Google Maps or Yelp in one click!"
      />
      <ReviewForm />
    </div>
  </div>
</section>
<DispatchModal />
<ReviewsScript />
