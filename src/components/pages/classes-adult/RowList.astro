---
// Label and value rows for topics, coaches, and prices. Same row treatment as the class-times list.
interface Props { items: { head: string; body: string }[] }
const { items } = Astro.props;
---
<ul class="list overflow-hidden rounded-box border border-neutral bg-base-200">
  {items.map((i) => (
    <li class="grid gap-1 border-b border-base-300 px-[18px] py-4 last:border-b-0 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:gap-6 sm:px-6 sm:py-[18px]">
      <span class="font-bold text-base-content">{i.head}</span>
      <span class="text-muted">{i.body}</span>
    </li>
  ))}
</ul>
