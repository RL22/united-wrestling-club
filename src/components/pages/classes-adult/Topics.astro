---
// A titled list of topics (sentence-case head plus one sentence), used for the boxing and open mat sections.
interface Props { items: { head: string; body: string }[] }
const { items } = Astro.props;
---
<ul class="list rounded-box border border-base-300 bg-base-200">
  {items.map((i) => <li><strong>{i.head}.</strong> <span class="text-base-content/70">{i.body}</span></li>)}
</ul>
