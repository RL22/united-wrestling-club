---
// Trial and drop-in rows for class pages. Membership tiers are listed on the pricing page.
import RowList from './RowList.astro';
import { facts } from '../../../data/facts';
interface Props { openMat?: boolean }
const { openMat = false } = Astro.props;
const items = [
  { head: facts.trialPass.name, body: `${facts.trialPass.price}. ${facts.trialPass.blurb}` },
  ...(openMat ? [{ head: 'Drop-in', body: `${facts.dropIn.price} per ${facts.dropIn.per}. ${facts.dropIn.note}` }] : []),
];
---
<RowList items={items} />
<p class="text-muted">Membership options vary by program. <a href="/pricing/" class="link link-hover text-base-content">View membership pricing</a>.</p>
