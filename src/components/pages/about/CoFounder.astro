---
// D22: Rashad Rahimi section, copied from discovery/archive/legacy-site/live_site_content/about.md section 3 (body copy and the three credential badges).
import { media } from '../../../data/media';
const badges = [
  { title: '1980 Olympic Qualifier', desc: 'Earned the right to compete at sport\'s pinnacle' },
  { title: 'Silver Medal', desc: 'Silver medal from asia games - One of wrestling\'s most prestigious international competitions' },
  { title: 'Silver Medal', desc: 'International Games - Proving consistency at the elite level' },
];
---
<section class="section-y border-t border-base-300" id="co-founder" aria-labelledby="co-founder-heading">
  <div class="container-uwc">
    <div class="mx-auto mb-10 max-w-[760px] text-center">
      <h2 class="text-3xl font-black uppercase leading-tight md:text-[2.75rem]" id="co-founder-heading">Co-Founder</h2>
    </div>
    <img src={media.coFounder.src} alt={media.coFounder.alt} loading="lazy" width="800" height="600" class="mb-6 h-auto max-w-full rounded-xl">
    <p class="max-w-2xl text-[1.05rem] leading-relaxed text-base-content/70">Rashad Rahimi brings world-class wrestling pedigree and decades of coaching expertise to our program. Rashad competed at the highest level of international wrestling, representing his country on the world stage during one of the most competitive eras in the sport's history. Beyond his competitive success, Rashad has dedicated his life to developing the next generation of wrestlers and grapplers. His coaching philosophy combines old-school toughness with technical precision, creating athletes who are both mentally resilient and technically sound. He understands what it takes to compete at the highest levels because he's been there himself.</p>
    <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
      {badges.map((b) => (
        <div class="card card-border border-base-300 bg-base-200">
          <div class="card-body gap-2 p-6">
            <h3 class="card-title text-xl font-extrabold uppercase">{b.title}</h3>
            <p class="text-sm leading-relaxed text-base-content/70">{b.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
