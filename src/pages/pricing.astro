---
import InteriorLayout from '../layouts/InteriorLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import PricingPlans from '../components/pages/info/PricingPlans.astro';
import TrialForm from '../components/forms/TrialForm.astro';
import { facts } from '../data/facts';

// Plans and checkout URLs: discovery/archive/legacy-site/live_site_content/pricing.json, as sourced.
const U = (id: number) => `https://www.wrestlingiq.com/users/sign_up?paid_session_id=${id}&show_registration=true&team_id=513`;
const plans = [
  { name: 'DROP IN', price: '15.00', period: 'per day', schedule: 'Flexible attendance', featured: false, url: U(2664) },
  { name: 'Kids (Pre k - 5th) 2 Day', price: '89.99', period: '/mo', schedule: 'Monday & Wednesday Only', featured: false, url: U(1087) },
  { name: 'Middle School / High School', price: '139.99', period: '/mo', schedule: 'Monday - Saturday', featured: false, url: U(2286) },
  { name: 'Competition Youth (K - 12th)', price: '150.00', period: '/mo', schedule: 'Monday - Saturday', featured: true, url: U(3574) },
  { name: 'ADULT / COLLEGE / HIGHSCHOOL', price: '139.99', period: '/mo', schedule: 'Monday - Saturday', featured: false, url: U(1084) },
  { name: 'BJJ / 3 days', price: '100', period: '/mo', schedule: '', featured: false, url: U(9536) },
];
---
<InteriorLayout
  title="Membership Options and Pricing | United Wrestling Club Hayward"
  description="Membership options, drop-in rates, and the $15 3-day trial at United Wrestling Club in Hayward, CA."
  path="/pricing/"
  current="pricing"
  cta={false}
>
  <PageHero eyebrow="PRICING" title="Membership" titleBrand="Options" lead="Invest in your wrestling journey with our flexible membership plans designed to fit your needs." compact />
  <section class="section-y" aria-labelledby="plans-heading">
    <div class="container-uwc">
      <SectionHeader title="Plans" lead={facts.membership.terms} id="plans-heading" />
      <PricingPlans plans={plans} />
      <div class="mx-auto mt-10 flex max-w-[960px] flex-col gap-5 min-[640px]:flex-row min-[640px]:items-center min-[640px]:justify-between">
        <div class="max-w-[520px]">
          <p class="m-0 text-base font-extrabold uppercase text-base-content">New here? {facts.trialPass.name}: {facts.trialPass.price}</p>
          <p class="m-0 mt-1 text-sm text-muted">{facts.trialPass.blurb}</p>
        </div>
        <Button trial variant="accent" class="min-h-11 w-full min-[640px]:w-auto">Start the 3-Day Mat Pass</Button>
      </div>
      <p class="mx-auto mt-7 mb-0 max-w-[960px] text-sm text-muted">{facts.booking.payment.note}</p>
    </div>
  </section>
  <section class="section-y bg-base-200" aria-labelledby="member-heading">
    <div class="container-uwc">
      <SectionHeader title="Start with the 3-Day Mat Pass" lead={facts.booking.howTo} id="member-heading" />
      <div class="mx-auto max-w-[560px]">
        <TrialForm idPrefix="prc" formId="pricingMemberForm" variant="page" sourceTag="pricing-membership" submitLabel="Confirm $15 3-Day Pass" />
      </div>
    </div>
  </section>
</InteriorLayout>
