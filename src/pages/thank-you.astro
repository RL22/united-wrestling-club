---
import InteriorLayout from '../layouts/InteriorLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { facts } from '../data/facts';
import ThankYouScript from '../components/pages/thank-you/ThankYouScript.astro';
---
<InteriorLayout
  title="Thank You | United Wrestling Club Hayward"
  description="Your request has been received by United Wrestling Club in Hayward, CA. Complete your registration and digital waiver on WrestlingIQ (Team #513)."
  path="/thank-you/"
  noindex={true}
  cta={false}
>
  <PageHero
    id="thank-you-heading"
    compact
    eyebrow="$15 · 3-Day Mat Pass Reserved"
    title="Pass reserved."
    titleBrand="Next step: WrestlingIQ"
    lead="Coach Naweed received your request. Complete your digital waiver and registration on WrestlingIQ (Team #513) before your first practice."
  />

  <section class="section-block" aria-labelledby="ty-card-heading">
    <div class="container">
      <div class="register-grid">
        <div class="form-card" id="ty-primary-card">
          <div id="ty-trial-checklist">
            <h2 class="section-title" id="ty-card-heading">Complete your waiver on WrestlingIQ</h2>
            <p class="section-lead" id="ty-card-lead">
              Your details are saved with our front desk. Finish your waiver online so you can step straight onto the mat when you arrive.
            </p>

            <div class="pass-summary">
              <div><strong>Selected Track:</strong> <span id="ty-program-row">$15 · 3-Day Mat Pass</span></div>
              <div class="pass-summary-row"><strong>Facility Address:</strong> {facts.address.full}</div>
              <div class="pass-summary-row"><strong>Locker Arrival:</strong> 15 minutes before scheduled practice</div>
              <div class="pass-summary-row"><strong>Attire:</strong> T-shirt and gym shorts (no pockets or zippers)</div>
              <div class="pass-summary-row"><strong>SMS Status:</strong> <span id="ty-sms-status-row">Opted Out (No automated texts will be sent)</span></div>
            </div>

            <a
              href="https://www.wrestlingiq.com/users/sign_up?paid_session_id=6327&show_registration=true&team_id=513"
              id="ty-wiq-btn"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-accent-glow btn-block btn-wiq"
            >
              Complete waiver on WrestlingIQ (Team #513) &nearr;
            </a>
          </div>

          <div id="ty-review-dispatch" hidden>
            <h2 class="section-title">Post your copied review</h2>
            <p class="section-lead">
              Your review text is copied to your clipboard. Select a platform below and paste your review.
            </p>
            <blockquote class="pass-summary" id="ty-review-preview">"Thank you for training at United Wrestling Club."</blockquote>
            <div class="form-actions" id="ty-review-platforms">
              <a
                href="https://search.google.com/local/writereview?placeid=ChIJsQd_yMaVj4ARrXw93nb4euo"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary btn-accent-glow btn-block"
              >
                1. Open Google Maps &amp; paste review &nearr;
              </a>
            </div>
            <p class="contact-card-note">
              <button type="button" class="btn btn-outline btn-block" id="ty-recopy-btn">Copy review text again</button>
            </p>
          </div>
        </div>

        <aside class="contact-card" aria-label="Fast-track arrival checklist">
          <h3 class="contact-card-title">Fast-track checklist</h3>
          <ol class="steps-list">
            <li>
              <strong>1. Skip the optional USAW screen.</strong> On Step 3 of WrestlingIQ (<em>Wrestler Info</em>), click <strong>Next</strong> past the optional USA Wrestling screen. You do not need a USAW card for a 3-day trial.
            </li>
            <li>
              <strong>2. Sign the online waiver.</strong> Complete the digital release form on WrestlingIQ before arriving at Suite C.
            </li>
            <li>
              <strong>3. Arrive 15 minutes early.</strong> Park in the main Industrial Pkwy lot and check in at the front desk.
            </li>
          </ol>
          <p class="contact-card-note">
            Need help with your pass? Call <a href={facts.phone.tel} class="footer-phone">{facts.phone.display}</a> or view the <a href="/schedule/">practice schedule</a>.
          </p>
        </aside>
      </div>
    </div>
  </section>
  <ThankYouScript />
</InteriorLayout>
