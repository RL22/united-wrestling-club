---
import InteriorLayout from '../layouts/InteriorLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ScheduleWeek from '../components/pages/schedule/ScheduleWeek.astro';
import FactList from '../components/ui/FactList.astro';
import TrialForm from '../components/forms/TrialForm.astro';
import { facts } from '../data/facts';
---
<InteriorLayout
  title="Class Schedule | United Wrestling Club Hayward"
  description="Weekly class times for youth, varsity, and adult wrestling and jiu-jitsu at United Wrestling Club in Hayward, CA."
  path="/schedule/"
  current="schedule"
  cta={false}
>
  <PageHero eyebrow="CLASS TIMES" title="Class" titleBrand="Schedule" lead="View our comprehensive class schedule and find the perfect time to train." compact />
  <section class="section-y" aria-labelledby="sch-week">
    <div class="container-uwc">
      <SectionHeader title="The week at a glance" lead="Pick a program on a phone. On a larger screen, the full week shows every class." id="sch-week" />
      <ScheduleWeek />
    </div>
  </section>
  <section class="section-y bg-base-200" aria-labelledby="sch-hours">
    <div class="container-uwc">
      <SectionHeader title="Gym hours" id="sch-hours" />
      <FactList show="hours" />
    </div>
  </section>
  <section class="section-y" aria-labelledby="sch-trial">
    <div class="container-uwc">
      <SectionHeader title="Try three practices for $15" lead={facts.booking.howTo} id="sch-trial" />
      <div class="mx-auto max-w-[560px]">
        <TrialForm idPrefix="sch" formId="scheduleTrialForm" variant="inline" sourceTag="schedule-f1b" />
      </div>
    </div>
  </section>
</InteriorLayout>
