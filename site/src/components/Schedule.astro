---
---
  <section class="schedule-section" id="schedule" aria-labelledby="schedule-heading">
    <div class="container">
      <div class="schedule-header">
        <span class="section-eyebrow">PRACTICE SCHEDULE</span>
        <h2 class="section-title" id="schedule-heading">Find Your Practice Time</h2>
        <p class="section-lead">Pick a program to see its weekly times at 30139 Industrial Pkwy SW, Hayward.</p>
      </div>

      <div class="schedule-tabs" role="tablist" aria-label="Programs">
        <button class="schedule-tab" role="tab" id="tab-youth" aria-controls="panel-youth" aria-selected="true" tabindex="0" type="button">Youth 5–13</button>
        <button class="schedule-tab" role="tab" id="tab-varsity" aria-controls="panel-varsity" aria-selected="false" tabindex="-1" type="button">Varsity 14–18</button>
        <button class="schedule-tab" role="tab" id="tab-adult" aria-controls="panel-adult" aria-selected="false" tabindex="-1" type="button">Adult 18+</button>
        <button class="schedule-tab" role="tab" id="tab-open" aria-controls="panel-open" aria-selected="false" tabindex="-1" type="button">Saturday Open Mat</button>
      </div>

      <div class="schedule-panel" role="tabpanel" id="panel-youth" aria-labelledby="tab-youth">
        <ul class="schedule-list">
          <li><span class="schedule-days">Mon &amp; Wed</span><span class="schedule-time">6:30 – 7:30 PM</span><span class="schedule-class">Kids, pre-K to 5th grade</span></li>
          <li><span class="schedule-days">Mon – Thu</span><span class="schedule-time">5:00 – 6:30 PM</span><span class="schedule-class">Team &amp; competition, K–12</span></li>
          <li><span class="schedule-days">Fri</span><span class="schedule-time">5:00 – 6:30 PM</span><span class="schedule-class">Kids competition</span></li>
        </ul>
      </div>

      <div class="schedule-panel" role="tabpanel" id="panel-varsity" aria-labelledby="tab-varsity" hidden>
        <ul class="schedule-list">
          <li><span class="schedule-days">Mon – Thu</span><span class="schedule-time">5:00 – 6:30 PM</span><span class="schedule-class">Team &amp; competition, K–12</span></li>
          <li><span class="schedule-days">Mon – Thu</span><span class="schedule-time">7:30 – 9:00 PM</span><span class="schedule-class">Adult &amp; high school</span></li>
          <li><span class="schedule-days">Tue &amp; Thu</span><span class="schedule-time">8:00 – 9:30 AM</span><span class="schedule-class">Adult, college &amp; high school</span></li>
        </ul>
      </div>

      <div class="schedule-panel" role="tabpanel" id="panel-adult" aria-labelledby="tab-adult" hidden>
        <ul class="schedule-list">
          <li><span class="schedule-days">Mon – Thu</span><span class="schedule-time">7:30 – 9:00 PM</span><span class="schedule-class">Adult &amp; high school</span></li>
          <li><span class="schedule-days">Mon – Thu</span><span class="schedule-time">9:00 – 9:30 PM</span><span class="schedule-class">Open, technique, conditioning &amp; strength</span></li>
          <li><span class="schedule-days">Fri</span><span class="schedule-time">8:00 – 9:30 PM</span><span class="schedule-class">Adult wrestling</span></li>
          <li><span class="schedule-days">Tue &amp; Thu</span><span class="schedule-time">8:00 – 9:30 AM</span><span class="schedule-class">Adult, college &amp; high school</span></li>
          <li><span class="schedule-days">Mon, Wed &amp; Fri</span><span class="schedule-time">6:30 – 8:00 AM</span><span class="schedule-class">Gi jiu-jitsu</span></li>
          <li><span class="schedule-days">Tue &amp; Thu</span><span class="schedule-time">6:30 – 7:30 PM</span><span class="schedule-class">Gi jiu-jitsu</span></li>
          <li><span class="schedule-days">Fri</span><span class="schedule-time">6:30 – 8:00 PM</span><span class="schedule-class">Boxing &amp; no-gi jiu-jitsu</span></li>
        </ul>
      </div>

      <div class="schedule-panel" role="tabpanel" id="panel-open" aria-labelledby="tab-open" hidden>
        <ul class="schedule-list">
          <li><span class="schedule-days">Saturday</span><span class="schedule-time">8:00 – 10:00 AM</span><span class="schedule-class">Gi jiu-jitsu</span></li>
          <li><span class="schedule-days">Saturday</span><span class="schedule-time">10:00 AM – 12:00 PM</span><span class="schedule-class">Open mat, all affiliations welcome</span></li>
        </ul>
      </div>

      <p class="schedule-note">Open Mon–Fri 6 AM–10 PM · Sat 10 AM–12 PM · Sun closed. Times can shift around holidays and tournaments. Call (510) 303-4869 to confirm your first session.</p>
      <p class="schedule-note"><a href="https://maps.google.com/?q=30139+Industrial+Pkwy+SW+Ste+C+Hayward+CA+94544" target="_blank" rel="noopener">30139 Industrial Pkwy SW Ste C, Hayward, CA 94544 · Get directions</a></p>
    </div>
  </section>

<style>
    .schedule-section {
      padding: var(--space-section) 0;
      background: var(--color-canvas);
    }

    .schedule-header {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 40px;
    }

    .schedule-tabs {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-bottom: 28px;
    }

    .schedule-tab {
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 0.82rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 12px 20px;
      border-radius: var(--radius-pill);
      border: 1px solid var(--color-border-default);
      background: var(--color-surface-1);
      color: var(--color-text-muted);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .schedule-tab:hover {
      color: var(--color-text-strong);
      border-color: var(--color-border-brand);
    }

    .schedule-tab[aria-selected="true"] {
      background: var(--color-brand);
      border-color: var(--color-brand);
      color: var(--color-text-strong);
    }

    .schedule-tab:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }

    .schedule-list {
      list-style: none;
      max-width: 860px;
      margin: 0 auto;
      background: var(--color-surface-1);
      border: 1px solid var(--color-border-default);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }

    .schedule-list li {
      display: grid;
      grid-template-columns: 150px 190px 1fr;
      gap: 16px;
      align-items: center;
      padding: 18px 24px;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .schedule-list li:last-child {
      border-bottom: none;
    }

    .schedule-days {
      font-weight: 700;
      color: var(--color-text-strong);
    }

    .schedule-time {
      font-weight: 600;
      color: var(--color-accent);
    }

    .schedule-class {
      color: var(--color-text-muted);
    }

    .schedule-note {
      text-align: center;
      color: var(--color-text-muted);
      font-size: 0.9rem;
      margin-top: 20px;
    }

    @media (max-width: 640px) {
      .schedule-list li {
        grid-template-columns: 1fr;
        gap: 4px;
        padding: 16px 18px;
      }
    }

  /* Cascade parity: global overrides for selectors used in this section */
