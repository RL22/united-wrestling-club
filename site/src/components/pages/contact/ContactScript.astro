<script is:inline>
    (function () {
      document.querySelectorAll('form[data-uwc-form="contact"]').forEach((cf) => {
        const status = cf.querySelector('.form-status');
        const success = cf.parentElement.querySelector('.form-success');
        cf.addEventListener('submit', (e) => {
          e.preventDefault();
          const btn = cf.querySelector('button[type="submit"]');
          if (status) status.hidden = true;
          if (btn) btn.disabled = true;
          window.UWCAttribution.submitLead(cf).then(() => {
            cf.hidden = true;
            if (success) success.hidden = false;
          }).catch(() => {
            if (status) {
              status.textContent = 'We could not send your message. Call (510) 303-4869 and we will reply.';
              status.hidden = false;
            }
          }).finally(() => {
            if (btn) btn.disabled = false;
          });
        });
      });
    })();

  
</script>
