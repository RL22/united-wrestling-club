---
// Plan cards from live_site_content/pricing.json (prices and URLs as sourced). Card markup follows home/Pricing.astro.
// Styles are scoped here because home/Pricing.astro's styles are scoped to that component.
import Button from '../../ui/Button.astro';
export type Plan = { name: string; price: string; period: string; schedule: string; featured: boolean; url: string };
interface Props { plans: Plan[] }
const { plans } = Astro.props;
---
<div class="plan-grid">
  {plans.map((p) => (
    <div class:list={['plan-card', { featured: p.featured }]}>
      {p.featured && <span class="plan-tag">Featured</span>}
      <h3 class="plan-name">{p.name}</h3>
      <div class="plan-figure"><span class="plan-val">${p.price}</span><span class="plan-period">{p.period}</span></div>
      {p.schedule && <p class="plan-desc">{p.schedule}</p>}
      <Button href={p.url} variant={p.featured ? 'primary' : 'outline'} block>Sign up on WrestlingIQ</Button>
    </div>
  ))}
</div>

<style>
  .plan-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .plan-card { position: relative; display: flex; flex-direction: column; background: var(--color-surface-1); border: 1px solid var(--color-border-default); border-radius: var(--radius-md); padding: 32px 26px; }
  .plan-card.featured { border: 2px solid var(--color-brand); }
  .plan-tag { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: var(--color-brand); color: var(--color-text-strong); font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; padding: 5px 16px; border-radius: var(--radius-pill); white-space: nowrap; }
  .plan-name { font-size: 1.1rem; font-weight: 800; text-transform: uppercase; color: var(--color-text-strong); margin-bottom: 14px; }
  .plan-figure { display: flex; align-items: baseline; gap: 6px; margin-bottom: 14px; }
  .plan-val { font-size: 2.4rem; font-weight: 900; font-family: var(--font-accent); color: var(--color-text-strong); line-height: 1; }
  .plan-period { font-size: 0.85rem; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; }
  .plan-desc { font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 22px; flex-grow: 1; }
  .plan-card :global(.btn) { margin-top: auto; }
  @media (max-width: 960px) { .plan-grid { grid-template-columns: minmax(0, 1fr); max-width: 480px; margin: 0 auto; } }
</style>
