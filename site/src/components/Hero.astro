  <section class="hero-section">
    <div class="hero-media">
      <video class="hero-video" autoplay loop muted playsinline poster="/video_assets/stills_selected/still_44_coach_naweed_mat_command_uwc_banner.jpg">
        <source src="/video_assets/loops/loop_homepage_hero_18s.mp4" type="video/mp4">
        <!-- Fallback Poster Still if video fails -->
        <img src="/video_assets/stills_selected/still_44_coach_naweed_mat_command_uwc_banner.jpg" alt="Coach Naweed directing mat practice under United Wrestling Club banner in Hayward">
      </video>
      <div class="hero-grunge-overlay"></div>
      <div class="hero-scrim"></div>
    </div>

    <div class="container hero-container">
      <div class="hero-content">
        
        <div class="hero-body-block">
          <h1 class="hero-title">
            Wrestling in Hayward. <br>
            <span class="crimson">For every stage.</span>
          </h1>

          <p class="hero-subtitle">
            A wrestling room in Hayward with named coaches. Try three practices for $15, then $139.99 a month with no contract.
          </p>

          <div class="hero-cta-group">
            <button class="btn btn-primary btn-accent-glow open-trial-modal">
              Try three practices for $15
            </button>
            
                      </div>

          
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Structured Program Silos (Balanced 4 Columns: Zero Orphans) -->

<style>
    .hero-section {
      position: relative;
      min-height: 75vh;
      min-height: 75svh;
      display: flex;
      align-items: center;
      padding: 60px 0 70px;
      background-color: #060709;
      border-bottom: 1px solid var(--color-border-default);
      overflow: hidden;
    }

    .hero-media {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      z-index: 1;
    }

    .hero-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 36%;
      filter: brightness(0.82) contrast(1.10) saturate(1.15);
    }

    /* Unsplash Grunge 001 Texture Overlay - Lightened for 1080p Mat Clarity */
    .hero-grunge-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('/unsplash-grunge-001.jpg');
      background-size: cover;
      background-position: center;
      mix-blend-mode: overlay;
      opacity: 0.05;
      pointer-events: none;
      z-index: 2;
    }

    /* Directional Scrim: Dark on left for text legibility, wide open center & right for mat action */
    .hero-scrim {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, rgba(9, 10, 13, 0.92) 0%, rgba(9, 10, 13, 0.84) 50%, rgba(9, 10, 13, 0.30) 78%, rgba(9, 10, 13, 0.06) 100%),
                  linear-gradient(180deg, rgba(9, 10, 13, 0.45) 0%, transparent 40%, rgba(9, 10, 13, 0.85) 100%);
      z-index: 2;
    }

    .hero-container {
      position: relative;
      z-index: 3;
    }

    .hero-content {
      max-width: 820px;
    }

    .hero-body-block {
      display: block;
    }
    .hero-title {
      font-size: clamp(2.5rem, 6.2vw, 4.6rem);
      font-weight: 900;
      line-height: 1.05;
      letter-spacing: -0.02em;
      text-transform: uppercase;
      color: var(--color-text-strong);
      margin-bottom: 22px;
    }

    .hero-title span.crimson {
      color: var(--color-accent);
      text-shadow: 0 2px 10px rgba(9, 10, 13, 0.85);
    }

    .hero-subtitle {
      font-size: clamp(1.08rem, 1.8vw, 1.3rem);
      font-weight: 400;
      line-height: 1.6;
      color: var(--color-text-muted);
      margin-bottom: 36px;
      max-width: 700px;
    }

    .hero-subtitle strong {
      color: var(--color-text-strong);
      font-weight: 600;
    }

    .hero-cta-group {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 48px;
    }

  @media (max-width: 768px) {
      /* 4. Mobile Hero - Center Video Clearance Layout */
      .hero-section {
        min-height: 75vh;
        min-height: 75svh;
        height: auto;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 0 !important;
        position: relative;
        border-bottom: 1px solid var(--color-border-default);
        box-sizing: border-box;
      }
      .hero-container {
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding-top: 20px;
        padding-bottom: 24px;
        box-sizing: border-box;
        position: relative;
        z-index: 3;
      }
      .hero-content {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex: 1 1 auto;
        height: auto;
        min-height: 0;
        width: 100%;
        max-width: 100%;
        text-align: left;
      }
      .hero-body-block {
        width: 100%;
        margin-top: auto; /* Drops H1, subtitle, and CTA down to the bottom */
        padding-top: 24px;
      }
      .hero-title {
        font-size: clamp(2.1rem, 9.2vw, 2.75rem);
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin-bottom: 12px;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
      }
      .hero-subtitle {
        font-size: clamp(0.92rem, 3.8vw, 1.04rem);
        line-height: 1.55;
        color: var(--color-text-default);
        margin-bottom: 18px;
        max-width: 95%;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
      }
      .hero-cta-group {
        display: block;
        width: 100%;
        max-width: 340px;
        margin-bottom: 0;
      }
      .hero-cta-group .btn.btn-primary {
        width: 100%;
        height: 50px;
        min-height: 50px;
        padding: 0 20px;
        font-size: 0.90rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 24px rgba(144, 37, 36, 0.6), 0 0 20px rgba(144, 37, 36, 0.4);
      }
      .hero-video {
        filter: brightness(0.78) contrast(1.12) saturate(1.15) !important;
        object-position: center 36% !important;
      }
      .hero-grunge-overlay {
        opacity: 0.05 !important;
      }
      /* Center clearance scrim: completely open center for takedown video visibility */
      .hero-scrim {
        background: linear-gradient(
          180deg,
          rgba(9, 10, 13, 0.50) 0%,
          rgba(9, 10, 13, 0.12) 18%,
          rgba(9, 10, 13, 0.02) 45%,
          rgba(9, 10, 13, 0.40) 55%,
          rgba(9, 10, 13, 0.78) 66%,
          rgba(9, 10, 13, 0.95) 100%
        ) !important;
      }
  }

