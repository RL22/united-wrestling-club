---
---
  <div class="noise-bg"></div>

  <!-- 1. Top Local Sanctioning & Schedule Marquee -->
  <aside class="top-bar" aria-label="Sanctioning">
    <p class="top-bar-line">USA Wrestling RTC #513 Sanctioned<span class="top-bar-extra">&nbsp;•&nbsp; Hayward, CA</span></p>
  </aside>

  <!-- 2. Sticky Navigation with Real UWC Emblem -->
  <header class="site-nav">
    <div class="container nav-inner">
      <a href="./" class="nav-brand" aria-label="United Wrestling Club Homepage">
        <img src="/assets/logo--uwc_wrestlers.svg" alt="United Wrestling Club" class="brand-logo-lockup">
      </a>

      <nav aria-label="Main Navigation" class="desktop-nav">
        <ul class="nav-links">
          <li><a href="#programs" class="nav-link">Classes</a></li>
          <li><a href="#schedule" class="nav-link">Schedule</a></li>
          <li class="nav-optional"><a href="#coaches" class="nav-link">Coaches</a></li>
          <li><a href="#testimonials" class="nav-link">Reviews</a></li>
          <li><a href="#pricing" class="nav-link">Pricing</a></li>
        </ul>
      </nav>

      <div class="nav-actions">
        <a href="tel:5103034869" class="nav-phone" aria-label="Call United Wrestling Club at 510-303-4869">
          <svg class="phone-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span class="phone-number">(510)&nbsp;303-4869</span>
        </a>
        <button class="btn btn-nav-cta open-trial-modal">
          <span class="btn-text-full">Try three practices for $15</span>
          <span class="btn-text-mobile">Try for $15</span>
        </button>
        <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobileNavDrawer">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Navigation Overlay & Drawer -->
  <div class="mobile-nav-backdrop" id="mobileNavBackdrop"></div>
  <aside class="mobile-nav-drawer" id="mobileNavDrawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <div class="mobile-nav-header">
      <div class="mobile-nav-brand">
        <img src="/assets/logo--uwc_wrestlers.svg" alt="United Wrestling Club" class="brand-logo-lockup">
      </div>
      <button class="mobile-nav-close" id="mobileNavClose" aria-label="Close navigation menu">&times;</button>
    </div>

    <nav aria-label="Mobile Navigation Links">
      <ul class="mobile-nav-links">
        <li><a href="#programs" class="mobile-nav-link">Classes &amp; Schedule</a></li>
        <li><a href="#coaches" class="mobile-nav-link">Coaches</a></li>
        <li><a href="#testimonials" class="mobile-nav-link">Reviews</a></li>
        <li><a href="#pricing" class="mobile-nav-link">Pricing ($139.99/mo)</a></li>
        <li><a href="#faq" class="mobile-nav-link">FAQ</a></li>
        <li><a href="#visit" class="mobile-nav-link">Find Us</a></li>
        <li><a href="/contact/" class="mobile-nav-link">Contact</a></li>
      </ul>
    </nav>

    <div class="mobile-nav-footer">
      <button class="btn btn-primary mobile-nav-cta open-trial-modal">
        Try three practices for $15
      </button>
      <div class="mobile-nav-contact">
        <a href="tel:5103034869" class="mobile-nav-contact-link" aria-label="Call (510) 303-4869">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          (510) 303-4869
        </a>
        <a href="https://maps.google.com/?q=30139+Industrial+Pkwy+SW+Ste+C+Hayward+CA+94544" target="_blank" class="mobile-nav-contact-link" aria-label="Directions to Hayward gym">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          30139 Industrial Pkwy SW, Hayward
        </a>
      </div>
    </div>
  </aside>

<style>
  .noise-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-image: radial-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 0);
    background-size: 24px 24px;
    pointer-events: none;
    z-index: 999;
    opacity: 0.8;
  }

  .top-bar {
    background-color: #07080a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    height: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
    color: var(--color-text-muted);
    position: relative;
    z-index: 101;
    display: flex;
    align-items: center;
    overflow: hidden;
    contain: paint;
    width: 100%;
    max-width: 100%;
    user-select: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, var(--color-canvas) 24px, var(--color-canvas) calc(100% - 24px), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, var(--color-canvas) 24px, var(--color-canvas) calc(100% - 24px), transparent 100%);
  }

  .site-nav {
    position: sticky;
    top: 0;
    width: 100%;
    background: rgba(7, 8, 10, 0.94);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    z-index: 100;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 74px;
    gap: 16px;
  }

  .mobile-menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    color: var(--color-text-strong);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    transition: background 0.2s, border-color 0.2s;
    flex-shrink: 0;
  }

  .mobile-menu-toggle:hover,
  .mobile-menu-toggle:focus {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .hamburger-bar {
    width: 20px;
    height: 2px;
    background-color: var(--color-text-strong);
    border-radius: 2px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s;
  }

  .mobile-menu-toggle.active .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-menu-toggle.active .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-toggle.active .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(4, 5, 8, 0.78);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
  }

  .mobile-nav-backdrop.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 86vw);
    background: #0d0f15;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: -10px 0 35px rgba(0, 0, 0, 0.85);
    z-index: 999;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 20px;
    box-sizing: border-box;
  }

  .mobile-nav-drawer.open {
    transform: translateX(0);
    visibility: visible;
  }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 14px;
  }

  .mobile-nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mobile-nav-close {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    color: var(--color-text-strong);
    font-size: 1.6rem;
    cursor: pointer;
    line-height: 1;
    transition: background 0.2s, border-color 0.2s;
  }

  .mobile-nav-close:hover {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .mobile-nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-grow: 1;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    padding: 12px 14px;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-strong);
    text-decoration: none;
    border-radius: var(--radius-sm);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background 0.2s, color 0.2s, padding-left 0.2s;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:active {
    background: rgba(144, 37, 36, 0.16);
    color: var(--color-text-strong);
    padding-left: 18px;
  }

  .mobile-nav-footer {
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .mobile-nav-cta {
    width: 100%;
    height: 48px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mobile-nav-contact {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mobile-nav-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 6px 4px;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .mobile-nav-contact-link:hover {
    color: var(--color-text-strong);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    position: relative;
    padding: 6px 0;
    display: inline-block;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text-strong);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: #902524;
    border-radius: 1px;
    transition: width 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .nav-phone {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-strong);
    text-decoration: none;
    font-family: var(--font-accent);
    font-size: 0.80rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .nav-phone:hover {
    color: var(--color-accent);
  }

  .nav-phone svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--color-brand-text);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .nav-phone:hover svg {
    transform: rotate(-6deg) scale(1.1);
    color: var(--color-accent);
  }

  .site-nav .btn,
  .btn.btn-nav-cta {
    background: linear-gradient(135deg, #a82e2d 0%, #902524 50%, #761d1c 100%);
    color: var(--color-text-strong);
    padding: 10px 20px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: 0 3px 12px rgba(144, 37, 36, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    height: 42px;
    min-height: 42px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-nav .btn:hover,
  .btn.btn-nav-cta:hover {
    background: linear-gradient(135deg, #b83332 0%, #a02928 50%, #82201f 100%);
    transform: translateY(-1px);
    box-shadow: 0 5px 20px rgba(144, 37, 36, 0.65), 0 0 16px rgba(144, 37, 36, 0.4);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .site-nav .btn:active,
  .btn.btn-nav-cta:active {
    transform: scale(0.97);
    box-shadow: 0 1px 6px rgba(144, 37, 36, 0.4);
  }

  .btn-text-mobile {
    display: none;
  }

  @media (max-width: 1240px) {
    .nav-links {
      gap: 15px;
    }
    .nav-link {
      font-size: 0.74rem;
    }
    .nav-actions {
      gap: 12px;
    }
    .nav-phone {
      font-size: 0.78rem;
    }
    .site-nav .btn,
    .btn.btn-nav-cta {
      padding: 9px 14px;
      font-size: 0.74rem;
    }
  }

  @media (max-width: 1040px) {
    .nav-links {
      gap: 12px;
    }
    .nav-link {
      font-size: 0.72rem;
    }
  }

  @media (max-width: 960px) {
    .desktop-nav,
    .nav-links {
      display: none !important;
    }
    .mobile-menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 768px) {
    header nav {
      display: none !important;
    }
    .nav-inner {
      height: 64px;
      gap: 8px;
      justify-content: space-between;
    }
    .nav-actions {
      gap: 8px;
      align-items: center;
    }
    .nav-phone {
      display: none !important;
    }
    .site-nav .btn,
    .btn.btn-nav-cta {
      height: 44px;
      min-height: 44px;
      padding: 0 14px;
      font-size: 0.80rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      box-shadow: 0 3px 12px rgba(144, 37, 36, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.22);
      white-space: nowrap;
    }
    .btn-text-full {
      display: none !important;
    }
    .btn-text-mobile {
      display: inline !important;
    }
  }

  @media (max-width: 380px) {
    .nav-inner {
      gap: 6px;
    }
    .nav-actions {
      gap: 6px;
    }
    .site-nav .btn,
    .btn.btn-nav-cta {
      padding: 0 10px;
      font-size: 0.72rem;
      height: 44px;
      min-height: 44px;
    }
  }

  .top-bar-line {
    margin: 0;
    padding: 8px 16px;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  @media (max-width: 1240px) {
    .nav-optional {
      display: none;
    }
    .nav-phone .phone-number {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .top-bar-extra {
      display: none;
    }
  }

