          </div>
        </div>

        <div>
          <div class="footer-col-title">Team #513 Mat Report</div>
          <p class="footer-note">Monthly news on events, medalists, and clinics.</p>
          <form class="newsletter-form" data-uwc-form="newsletter" novalidate>
            <label class="visually-hidden" for="v01-news-email">Email address</label>
            <input type="email" id="v01-news-email" name="email" class="form-input" placeholder="you@example.com" required autocomplete="email">
            <label class="tcpa-checkbox-label" for="v01-news-consent">
              <input type="checkbox" id="v01-news-consent" name="email_consent" value="yes">
              <span>Email me the Team #513 Mat Report. Unsubscribe anytime.</span>
            </label>
            <button type="submit" class="btn btn-outline btn-block">Subscribe</button>
            <p class="form-status" role="status" hidden></p>
          </form>
        </div>

        <div>
          <div class="footer-col-title">Programs</div>
          <ul class="footer-links">
            <li><a href="#programs">Youth Wrestling (Ages 5–13)</a></li>
            <li><a href="#programs">Varsity Scholastic Prep (14–18)</a></li>
            <li><a href="#programs">Adult Wrestling & Grappling</a></li>
            <li><a href="#programs">Combat Sambo & BJJ</a></li>
            <li><a href="#programs">Saturday Open Mat ($15)</a></li>
          </ul>
        </div>

        <div>
          <div class="footer-col-title">Academy</div>
          <ul class="footer-links">
            <li><a href="#lineage">Our heritage</a></li>
            <li><a href="/about/">Our standards</a></li>
            <li><a href="#lineage">Coach Naweed Zemaryalai</a></li>
            <li><a href="#lineage">Karim Zemaryalai</a></li>
            <li><a href="#safety">Mat Room & Safety</a></li>
            <li><a href="#pricing">Tuition & Pricing</a></li>
            <li><a href="#coaches">Coaches</a></li>
            <li><a href="#faq">FAQ</a></li>
          </ul>
        </div>

        <div>
          <div class="footer-col-title">Hayward Headquarters</div>
          <div class="footer-nap">
            <div><strong>United Wrestling Club</strong></div>
            <div>30139 Industrial Pkwy SW Ste C<br>Hayward, CA 94544</div>
            <div class="footer-line">
              <a href="tel:5103034869" class="footer-phone">(510) 303-4869</a>
            </div>
            <div>
              <a href="mailto:unitedwrestlingclub@gmail.com">unitedwrestlingclub@gmail.com</a>
            </div>
            <div class="footer-line footer-line--sm">
              Mon–Fri: 6:00 AM – 10:00 PM<br>
              Saturday: 10:00 AM – 12:00 PM<br>
              Sunday: Closed
            </div>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <div>&copy; 2026 United Wrestling Club. All rights reserved. Registered USA Wrestling RTC #513.</div>
        <div>
          Serving Hayward • Union City • Fremont • San Leandro • Castro Valley • Newark, CA
        </div>
      </div>
    </div>
  </footer>

<style>
    .site-footer {
      background-color: #060709;
      padding: 70px 0 30px;
      font-size: 0.88rem;
      color: var(--color-text-muted);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
      gap: 40px;
      margin-bottom: 60px;
    }

    .footer-col-title {
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-text-strong);
      margin-bottom: 20px;
    }

    .footer-links {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .footer-links a {
      color: var(--color-text-muted);
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 4px 0;
      transition: color 0.2s;
      text-decoration: none;
    }
    .footer-links a:hover {
      color: var(--color-text-strong);
    }
    .footer-nap a {
      color: var(--color-text-muted);
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 4px 0;
      transition: color 0.2s;
      text-decoration: none;
    }
    .footer-nap a:hover {
      color: var(--color-text-strong);
    }

    .footer-nap {
      display: flex;
      flex-direction: column;
      gap: 10px;
      line-height: 1.5;
    }

    .footer-bottom {
      padding-top: 30px;
      border-top: 1px solid var(--color-border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
      font-size: 0.78rem;
    }

@media (max-width: 960px) {
      .footer-grid {
        grid-template-columns: repeat(2, 1fr);
      }
}

@media (max-width: 768px) {
      .footer-grid {
        grid-template-columns: 1fr;
      }
}

    .footer-social-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 18px;
    }

    .footer-social-link {
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
      border-radius: var(--radius-sm);
      background: var(--color-surface-1);
      border: 1px solid var(--color-border-default);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text-muted);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .footer-social-link:hover {
      color: var(--color-text-strong);
      background: var(--color-brand);
      border-color: var(--color-brand);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(144, 37, 36, 0.4);
    }

.drawer-brand { margin-bottom: 16px; }
.footer-note { font-size: 0.85rem; line-height: 1.6; margin-bottom: 16px; }
.footer-alert { font-size: 0.78rem; color: var(--color-accent); font-weight: 700; }
.footer-line { margin-top: 6px; }
.footer-line--sm { font-size: 0.8rem; }
.site-footer .footer-phone { color: var(--color-text-strong); font-weight: 700; }

.newsletter-form {
  display: grid;
  gap: 10px;
  margin-top: 14px;
}
.newsletter-form .form-input { min-height: 44px; }
.newsletter-form .tcpa-checkbox-label { font-size: 0.8rem; }

