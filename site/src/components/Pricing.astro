---
---
<section class="pricing-section" id="pricing">
    <div class="container">
      <div style="text-align: center; max-width: 680px; margin: 0 auto;">
        <span class="section-eyebrow">TRANSPARENT TUITION</span>
        <h2 class="section-title">No Contracts. No Hidden&nbsp;Fees.</h2>
        <p class="section-lead" style="margin: 0 auto;">
          Month-to-month, no contracts, no initiation fees. Try three practices first, then decide.
        </p>
      </div>

      <div class="pricing-grid">
        <!-- 3-Day Mat Pass -->
        <div class="pricing-card">
          <h3 class="price-name">3-Day Mat Pass</h3>
          <p class="price-desc">Three practices to see if the room fits. New members only.</p>
          <div class="price-figure">
            <span class="price-val">$15</span>
            <span class="price-period">/ 3 practices</span>
          </div>
          <ul class="price-features">
            <li class="price-feature">Any age-appropriate class</li>
            <li class="price-feature">Gear fitting and 1-on-1 check-in with Coach Naweed</li>
          </ul>
          <button class="btn btn-outline open-trial-modal">Try three practices for $15</button>
        </div>

        <!-- Monthly Unlimited (Featured) -->
        <div class="pricing-card featured">
          <span class="featured-tag">MOST POPULAR</span>
          <h3 class="price-name">Monthly Unlimited</h3>
          <p class="price-desc">All weekly practices and Saturday open mat.</p>
          <div class="price-figure">
            <span class="price-val">$139.99</span>
            <span class="price-period">/&nbsp;Month</span>
          </div>
          <ul class="price-features">
            <li class="price-feature">Month-to-month, no contracts</li>
            <li class="price-feature">No initiation fees</li>
            <li class="price-feature">Saturday open mat included</li>
          </ul>
          <button class="btn btn-primary btn-accent-glow open-trial-modal">Start Monthly Membership</button>
        </div>

        <!-- Single Mat Drop-In -->
        <div class="pricing-card">
          <h3 class="price-name">Single Mat Drop-In</h3>
          <p class="price-desc">For visiting wrestlers and Saturday open mat guests.</p>
          <div class="price-figure">
            <span class="price-val">$15</span>
            <span class="price-period">/&nbsp;Visit</span>
          </div>
          <ul class="price-features">
            <li class="price-feature">One practice or Saturday open mat</li>
            <li class="price-feature">Pay at the door</li>
          </ul>
          <button class="btn btn-outline open-trial-modal">Pay Drop-In at Door</button>
        </div>
      </div>
    </div>
  </section>

<style>
  .pricing-section {
    padding: var(--space-section) 0;
    background-color: #0b0c10;
    border-top: 1px solid var(--color-border-default);
    border-bottom: 1px solid var(--color-border-default);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 48px;
    align-items: stretch;
  }

  .pricing-card {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    padding: 36px 30px;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .pricing-card.featured {
    background: linear-gradient(180deg, #181b24 0%, #111319 100%);
    border: 2px solid var(--color-brand);
    box-shadow: 0 12px 40px rgba(144, 37, 36, 0.25);
    transform: scale(1.02);
  }

  .featured-tag {
    white-space: nowrap !important;
  }

  .featured-tag {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-brand);
    color: var(--color-text-strong);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 5px 16px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .price-name {
    font-size: 1.3rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-text-strong);
    margin-bottom: 8px;
  }

  .price-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 24px;
    min-height: 40px;
    text-wrap: pretty;
  }

  .price-figure {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .price-val {
    font-size: 2.8rem;
    font-weight: 900;
    font-family: var(--font-accent);
    color: var(--color-text-strong);
    line-height: 1;
  }

  .price-period {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .price-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 36px;
    flex-grow: 1;
  }

  .price-feature {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--color-text-default);
  }

  @media (max-width: 960px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 768px) {
    .pricing-grid {
      grid-template-columns: minmax(0, 1fr) !important;
      width: 100% !important;
      max-width: 100% !important;
      gap: 20px !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }
    .pricing-card {
      padding: 28px 18px !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
    .pricing-card.featured {
      transform: none !important;
    }
    .pricing-card .btn {
      width: 100% !important;
      padding: 14px 16px !important;
      font-size: 0.85rem !important;
      white-space: normal !important;
      box-sizing: border-box !important;
    }
  }

  /* Cascade parity: global overrides for selectors used in this section */
