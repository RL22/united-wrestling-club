---
---
    <!-- 7. Lineage & Coaching Moat (Textured with Unsplash Grunge) -->
  <section class="lineage-section" id="coaches">
    <span id="lineage" style="display:block; position:relative; top:-90px; visibility:hidden;"></span>
    <div class="container">
      <div class="lineage-layout">
        <div class="lineage-visual">
          <div class="lineage-frame">
            <img src="/video_assets/stills_selected/still_31_naweed_headshot_united_wall.jpg" alt="Head Wrestling Coach Naweed Zemaryalai under the United Wrestling Club wall in Hayward">
          </div>
        </div>

        <div class="lineage-editorial">
          <span class="section-eyebrow">UNMATCHED PEDIGREE</span>
          <h2 class="section-title">Coached by Champions, Grounded in&nbsp;Science</h2>
          <p class="section-lead">
            International-grade wrestling forged in Dagestan and collegiate competition.
          </p>

          <div class="coach-roster">
            <div class="coach-card-line">
              <div>
                <div class="coach-info-title">
                  Karim Zemaryalai
                  <span class="coach-role-tag"><svg width="11" height="11" viewBox="0 0 512 512" fill="currentColor" style="vertical-align:-1px; margin-right:4px;"><path d="M223.75 130.75L154.62 15.54A31.997 31.997 0 0 0 127.18 0H16.03C3.08 0-4.5 14.57 2.92 25.18l111.27 158.96c29.72-27.77 67.52-46.83 109.56-53.39zM495.97 0H384.82c-11.24 0-21.66 5.9-27.44 15.54l-69.13 115.21c42.04 6.56 79.84 25.62 109.56 53.38L509.08 25.18C516.5 14.57 508.92 0 495.97 0zM256 160c-97.2 0-176 78.8-176 176s78.8 176 176 176 176-78.8 176-176-78.8-176-176-176zm92.52 157.26l-37.93 36.96 8.97 52.22c1.6 9.36-8.26 16.51-16.65 12.09L256 393.88l-46.9 24.65c-8.4 4.45-18.25-2.74-16.65-12.09l8.97-52.22-37.93-36.96c-6.82-6.64-3.05-18.23 6.35-19.59l52.43-7.64 23.43-47.52c2.11-4.28 6.19-6.39 10.28-6.39 4.11 0 8.22 2.14 10.33 6.39l23.43 47.52 52.43 7.64c9.4 1.36 13.17 12.95 6.35 19.59z"/></svg>Founder & Master Coach</span>
                </div>
                <div class="coach-info-bio">
                  Medalist at the Ali Aliyev Tournament in Makhachkala, Dagestan. Karim brought Dagestani hand-fighting, ankle picks, and relentless mat pressure to Northern California.
                </div>
              </div>
            </div>

            <div class="coach-card-line">
              <div>
                <div class="coach-info-title">
                  Naweed Zemaryalai
                  <span class="coach-role-tag"><svg width="13" height="13" viewBox="0 0 640 512" fill="currentColor" style="vertical-align:-1px; margin-right:4px;"><path d="M622.34 153.2L343.4 67.5c-15.2-4.67-31.6-4.67-46.79 0L17.66 153.2c-23.54 7.23-23.54 38.36 0 45.59l48.63 14.94c-10.67 13.19-17.23 29.28-17.88 46.9C38.78 266.15 32 276.11 32 288c0 10.78 5.68 19.85 13.86 25.65L20.33 428.53C18.11 438.52 25.71 448 35.94 448h56.11c10.24 0 17.84-9.48 15.62-19.47L82.14 313.65C90.32 307.85 96 298.78 96 288c0-11.57-6.47-21.25-15.66-26.87.76-15.02 8.44-28.3 20.69-36.72L296.6 284.5c9.06 2.78 26.44 6.25 46.79 0l278.95-85.7c23.55-7.24 23.55-38.36 0-45.6zM352.79 315.09c-28.53 8.76-52.84 3.92-65.59 0l-145.02-44.55L128 384c0 35.35 85.96 64 192 64s192-28.65 192-64l-14.18-113.47-145.03 44.56z"/></svg>Head Coach & Kinesiologist</span>
                </div>
                <div class="coach-info-bio">
                  Son of Karim; former collegiate wrestler at Chabot College and San Francisco State (B.S. in Kinesiology), now a Chabot College coach. Naweed brings biomechanics, injury prevention, and chain wrestling to every practice.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Secondary 4-Column Coaching Staff Row -->
      <div class="coaches-secondary-wrap">
        <div class="coaches-secondary-header">
          <span class="section-eyebrow">THE CORNER · EAST BAY COACHING STAFF</span>
          <h3 class="coaches-secondary-title">Decades of Mat Mastery Across Every Discipline</h3>
        </div>

        <div class="coach-grid-secondary">
          <!-- Coach 1: Rashad Rahimi -->
          <article class="coach-card-secondary">
            <div class="coach-photo-secondary">
              <img src="/live_site_content/assets/co-founder.jpg" alt="Coach Rashad Rahimi, UWC Co-Founder and Asian Games Silver Medalist" loading="lazy" width="800" height="600">
              <span class="image-label">Asian Games Silver</span>
            </div>
            <div class="coach-info-secondary">
              <span class="coach-role">Co-Founder</span>
              <h4 class="coach-name">Rashad Rahimi</h4>
              <p class="coach-bio">Asian Games silver medalist. Coach Rashad teaches championship footwork and high-level freestyle.</p>
            </div>
          </article>

          <!-- Coach 2: Sandeep Singh Gosal -->
          <article class="coach-card-secondary">
            <div class="coach-photo-secondary">
              <img src="/video_assets/stills_selected/still_09_coach_community_mat.jpg" alt="Coach Sandeep Singh Gosal coaching the youth wrestling tournament squad" loading="lazy" width="800" height="600">
              <span class="image-label">James Logan / Fresno State</span>
            </div>
            <div class="coach-info-secondary">
              <span class="coach-role">Competitive Youth Coach</span>
              <h4 class="coach-name">Sandeep Singh Gosal</h4>
              <p class="coach-bio">James Logan High School graduate who wrestled at Fresno State and San Francisco State. Coach Sandeep now coaches the competition youth class.</p>
            </div>
          </article>

          <!-- Coach 4: Farid Siddiq -->
          <article class="coach-card-secondary">
            <div class="coach-photo-secondary">
              <img src="/video_assets/stills_selected/still_49_sergio_gomez_striking_usa_wrestling_olympic_banner.jpg" alt="Coach Farid Siddiq coaching combat striking mechanics under the USA Wrestling banner" loading="lazy" width="800" height="600">
              <span class="image-label">Striking Specialist</span>
            </div>
            <div class="coach-info-secondary">
              <span class="coach-role">Boxing &amp; Striking Fundamentals</span>
              <h4 class="coach-name">Farid Siddiq</h4>
              <p class="coach-bio">Striking specialist who trains wrestlers in head movement, punching mechanics, distance management, and hip rotation.</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

<style>
  .lineage-floating-badge {
    position: absolute;
    bottom: -20px;
    right: 20px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-brand);
    padding: 16px 22px;
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .floating-badge-logo {
    height: 44px;
    width: auto;
    max-width: 68px;
    object-fit: contain;
  }

  .floating-badge-text-wrap {
    display: flex;
    flex-direction: column;
  }

  .floating-badge-year {
    font-size: 1.6rem;
    font-weight: 900;
    font-family: var(--font-accent);
    color: var(--color-text-strong);
    line-height: 1;
  }

  .floating-badge-text {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-brand-text);
    margin-top: 3px;
  }

  .coaches-secondary-wrap {
    margin-top: 36px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border-default);
  }

  .coaches-secondary-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 28px;
  }

  .coaches-secondary-title {
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-strong);
    margin-top: 10px;
    text-wrap: balance;
  }

  .coach-grid-secondary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .coach-card-secondary {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
    flex-direction: row;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .coach-card-secondary:hover {
    border-color: var(--color-brand);
    transform: translateY(-3px);
  }

  .coach-photo-secondary {
    position: relative;
    aspect-ratio: auto;
    flex: 0 0 34%;
    overflow: hidden;
    background: #111318;
  }

  @media (max-width: 600px) {
    .coach-card-secondary {
      flex-direction: column;
    }
    .coach-photo-secondary {
      aspect-ratio: 4/3;
      flex: none;
    }
  }

  .coach-photo-secondary img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 0.35s ease;
  }

  .coach-card-secondary:hover .coach-photo-secondary img {
    transform: scale(1.04);
  }

  .coach-photo-secondary .image-label {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: rgba(9, 10, 13, 0.88);
    color: var(--color-warning);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .coach-info-secondary {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .coach-role {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-warning);
    margin-bottom: 6px;
  }

  .coach-name {
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-text-strong);
    margin-bottom: 10px;
  }

  .coach-bio {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 0;
    flex-grow: 1;
    text-wrap: pretty;
  }

  @media (max-width: 1024px) {
    .coach-grid-secondary {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .coach-grid-secondary {
      grid-template-columns: 1fr;
    }
  }

  .lineage-section {
    padding: var(--space-section-tight);
    background-color: var(--color-surface-0);
    background-image: linear-gradient(180deg, rgba(11, 13, 17, 0.94) 0%, rgba(11, 13, 17, 0.98) 100%), url('/unsplash-grunge-001.jpg');
    background-size: cover;
    background-position: center;
    border-top: 1px solid var(--color-border-default);
    border-bottom: 1px solid var(--color-border-default);
    position: relative;
  }

  .lineage-layout {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(40px, 6vw, 70px);
    align-items: center;
  }

  .lineage-visual {
    position: relative;
  }

  .lineage-frame {
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface-1);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
  }

  .lineage-frame img {
    width: 100%;
    height: 520px;
    object-fit: cover;
    object-position: center 20%;
  }

  .lineage-editorial {
    display: flex;
    flex-direction: column;
  }

  .coach-roster {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 36px;
  }

  .coach-card-line {
    display: flex;
    gap: 20px;
    padding: 20px;
    background: rgba(17, 19, 24, 0.85);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
  }

  .coach-info-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text-strong);
    margin-bottom: 2px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .coach-role-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    background: rgba(144, 37, 36, 0.2);
    color: var(--color-accent);
    border-radius: 3px;
    white-space: nowrap !important;
  }

  .coach-info-bio {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-top: 6px;
  }

  @media (max-width: 960px) {
    .lineage-layout {
      grid-template-columns: 1fr;
    }
    .lineage-frame img {
      height: 380px;
    }
  }
</style>
