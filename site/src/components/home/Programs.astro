---
  <section class="programs-section" id="programs">
    <div class="container">
      <div class="programs-header-row">
        <div>
          <span class="section-eyebrow">CHAMPIONSHIP CURRICULUM</span>
          <h2 class="section-title">Programs For Every&nbsp;Stage</h2>
          <p class="section-lead">
            Youth, scholastic and adult classes in Hayward. Pick the program that fits, then try three practices for $15. Our Google rating is 5.0 across 42 reviews, and the Dollamur mats are sanitized twice a day.
          </p>
        </div>
        <a href="/classes/" class="btn btn-outline">Explore all classes</a>
      </div>

      <div class="programs-grid">
        <!-- Youth Academy -->
        <div class="program-card">
          <div class="card-media">
            <span class="card-badge">Kids and youth</span>
            <img class="card-img" src="/video_assets/cards/program-youth.jpg" alt="Youth wrestlers working a stance drill on the UWC red mat">
          </div>
          <div class="card-body">
            <h3 class="card-title">Youth Wrestling&nbsp;Academy</h3>
            <div class="card-meta"><svg width="12" height="12" viewBox="0 0 512 512" fill="currentColor" style="vertical-align:-1px; margin-right:4px;"><path d="M256,8C119,8,8,119,8,256S119,504,256,504,504,393,504,256,393,8,256,8Zm92.49,313h0l-20,25a16,16,0,0,1-22.49,2.5h0l-67-49.72a40,40,0,0,1-15-31.23V112a16,16,0,0,1,16-16h32a16,16,0,0,1,16,16V256l58,42.5A16,16,0,0,1,348.49,321Z"/></svg>Mon &amp; Wed • 6:30 – 7:30 PM</div>
            <p class="card-desc">
              Foundational Folkstyle and Freestyle fundamentals designed to build athletic confidence, spatial awareness, anti-bullying resilience, and respectful sportsmanship.
            </p>
            <div class="card-footer">
              <a href="#trial" class="card-link open-trial-modal">Try Youth for $15 &rarr;</a>
            </div>
          </div>
        </div>

        <!-- Varsity High School -->
        <div class="program-card">
          <div class="card-media">
            <span class="card-badge">Middle and high school</span>
            <img class="card-img" src="/video_assets/cards/program-varsity.jpg" alt="Athlete in an airborne lateral drop during live drilling at UWC">
          </div>
          <div class="card-body">
            <h3 class="card-title">Varsity & Scholastic&nbsp;Prep</h3>
            <div class="card-meta"><svg width="12" height="12" viewBox="0 0 512 512" fill="currentColor" style="vertical-align:-1px; margin-right:4px;"><path d="M256,8C119,8,8,119,8,256S119,504,256,504,504,393,504,256,393,8,256,8Zm92.49,313h0l-20,25a16,16,0,0,1-22.49,2.5h0l-67-49.72a40,40,0,0,1-15-31.23V112a16,16,0,0,1,16-16h32a16,16,0,0,1,16,16V256l58,42.5A16,16,0,0,1,348.49,321Z"/></svg>Mon – Thu • 7:30 – 9:00 PM</div>
            <p class="card-desc">
              High-intensity competition training for East Bay high schoolers pursuing CIF state qualification and collegiate recruitment. Advanced hand-fighting, chained takedowns, and live simulation.
            </p>
            <div class="card-footer">
              <a href="#trial" class="card-link open-trial-modal">Try Varsity for $15 &rarr;</a>
            </div>
          </div>
        </div>

        <!-- Adult Wrestle-Jitsu -->
        <div class="program-card">
          <div class="card-media">
            <span class="card-badge">Adults</span>
            <img class="card-img" src="/video_assets/cards/program-adult.jpg" alt="Two adult grapplers in a collar tie during a UWC adult class">
          </div>
          <div class="card-body">
            <h3 class="card-title">Adult Wrestling & Wrestle-Jitsu</h3>
            <div class="card-meta"><svg width="12" height="12" viewBox="0 0 512 512" fill="currentColor" style="vertical-align:-1px; margin-right:4px;"><path d="M256,8C119,8,8,119,8,256S119,504,256,504,504,393,504,256,393,8,256,8Zm92.49,313h0l-20,25a16,16,0,0,1-22.49,2.5h0l-67-49.72a40,40,0,0,1-15-31.23V112a16,16,0,0,1,16-16h32a16,16,0,0,1,16,16V256l58,42.5A16,16,0,0,1,348.49,321Z"/></svg>Mon – Thu • 7:30 – 9:00 PM</div>
            <p class="card-desc">
              Collegiate wrestling tailored for adults, BJJ practitioners, and combat athletes. Master takedown defense, cage control, and underhooks in an ego-free, high-camaraderie room.
            </p>
            <div class="card-footer">
              <a href="#trial" class="card-link open-trial-modal">Try Adult for $15 &rarr;</a>
            </div>
          </div>
        </div>

        <!-- Saturday Open Mat -->
        <div class="program-card">
          <div class="card-media">
            <span class="card-badge">All Levels</span>
            <img class="card-img" src="/video_assets/cards/program-openmat.jpg" alt="Wrestlers and grapplers in a Saturday open mat session at UWC">
          </div>
          <div class="card-body">
            <h3 class="card-title">Saturday Open&nbsp;Mat</h3>
            <div class="card-meta"><svg width="12" height="12" viewBox="0 0 512 512" fill="currentColor" style="vertical-align:-1px; margin-right:4px;"><path d="M256,8C119,8,8,119,8,256S119,504,256,504,504,393,504,256,393,8,256,8Zm92.49,313h0l-20,25a16,16,0,0,1-22.49,2.5h0l-67-49.72a40,40,0,0,1-15-31.23V112a16,16,0,0,1,16-16h32a16,16,0,0,1,16,16V256l58,42.5A16,16,0,0,1,348.49,321Z"/></svg>Saturday • 10:00 AM – 12:00 PM</div>
            <p class="card-desc">
              Bay Area combat open mat. Live situational sparring, positional rounds, and technique exchanges under coach supervision. $15 mat fee for guests, free for academy members.
            </p>
            <div class="card-footer">
              <a href="#trial" class="card-link open-trial-modal">Join Saturday Mat &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

    <!-- 5b. Weekly Schedule with Section Tab Nav -->

<style>
  .programs-section {
    padding: var(--space-section) 0;
    background-color: var(--color-canvas);
    position: relative;
  }

  .programs-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 48px;
  }

  /* Balanced 4-column desktop grid: 0 orphans */

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .program-card {
    background-color: var(--color-surface-1);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    position: relative;
  }

  .program-card:hover {
    transform: translateY(-6px);
    border-color: rgba(144, 37, 36, 0.45);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5), 0 0 20px rgba(144, 37, 36, 0.2);
  }

  .program-card:hover .card-img {
    transform: scale(1.05);
  }

  @media (max-width: 1220px) {
    .programs-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 768px) {
    .programs-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
