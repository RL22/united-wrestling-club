---
---

  <section class="cta-banner">
    <div class="container">
      <div class="cta-banner-content">
        <span class="section-eyebrow text-accent">STEP ONTO THE MAT THIS WEEK</span>
        <h2 class="cta-banner-title">Step onto the mat in&nbsp;Hayward</h2>
        <p class="cta-banner-sub">
          Try three practices for just $15. Meet Head Coach Naweed, experience our mat culture, and see why East Bay champions train at UWC.
        </p>
        <button class="btn btn-primary btn-accent-glow open-trial-modal cta-banner-btn">
          Try three practices for $15
        </button>
      </div>
    </div>
  </section>

<style>
  .cta-banner {
    padding: clamp(60px, 8vw, 100px) 0;
    background: linear-gradient(135deg, rgba(17, 19, 26, 0.94) 0%, rgba(27, 14, 14, 0.92) 50%, rgba(9, 10, 13, 0.96) 100%), url('/unsplash-grunge-001.jpg');
    background-size: cover;
    background-position: center;
    border-top: 1px solid var(--color-border-brand);
    border-bottom: 1px solid var(--color-border-default);
    position: relative;
    overflow: hidden;
  }

  .cta-banner-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .cta-banner-title {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-text-strong);
    line-height: 1.1;
    margin-bottom: 18px;
  }

  .cta-banner-sub {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 34px;
  }

  @media (max-width: 768px) {
    .cta-banner .btn,
        .cta-banner-btn {
      width: 100% !important;
      max-width: 360px !important;
      padding: 16px 20px !important;
      font-size: 0.88rem !important;
      white-space: normal !important;
      box-sizing: border-box !important;
      margin: 0 auto !important;
    }
  }
</style>
