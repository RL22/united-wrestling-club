---
import { reviews } from '../../data/reviews';
const excerpts = [
  'I’ve watched my son grow more confident, disciplined, and mentally stronger every week...',
  'Healthy competition, humble egos, and a room full of experienced grapplers and MMA fighters pushing each other daily.',
  'Everyone was welcoming, supportive, and treated him like part of the team from the very start.',
  'This club has an amazing and positive vibe. It is all about competitive wrestling and the instructors go deep into technique.',
  'Both my boys have blossomed here. No contracts, straightforward pricing, and unmatched coaching.',
  'The caliber of training partners is unbelievable, but zero ego. 10/10 recommendation.',
  'The level of high school freestyle and folkstyle coaching under Coach Naweed and the team is the best in the East Bay.',
  'Immense gratitude for the hospitality and the grueling, technical session.',
];
if (reviews.some((review, index) => !review.body.includes(excerpts[index]))) throw new Error('Testimonial excerpt does not match its source');
---
<section class="testimonials-section" id="testimonials" aria-labelledby="testimonials-heading">
  <div class="container">
    <header class="testimonials-head">
      <span class="section-eyebrow">COMMUNITY PROOF · REVIEWS FROM THE MAT</span>
      <h2 id="testimonials-heading" class="section-title">Voices From the Mat. Unfiltered &amp; Earned.</h2>
      <p class="section-lead">Hear from parents, competitors, and everyday grinders training in Hayward.</p>
    </header>
    <div class="slider-heading">
      <p>Stories from our community</p>
      <div class="slider-controls" role="group" aria-label="Testimonial controls">
        <button type="button" data-direction="-1" aria-label="Previous testimonials">←</button>
        <button type="button" data-direction="1" aria-label="Next testimonials">→</button>
      </div>
    </div>
    <div class="testimonial-track" role="region" tabindex="0" aria-label="Community testimonials; scroll horizontally to see more">
      {reviews.map((review, index) => (
        <article class="testimonial-card">
          <span class="testimonial-stars" role="img" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}</span>
          <p class="testimonial-quote">“{excerpts[index]}”</p>
          <div class="testimonial-attribution"><strong>{review.author}</strong><span>{review.platform} review</span></div>
        </article>
      ))}
    </div>
    <div class="testimonials-actions">
      <a href="https://search.google.com/local/writereview?placeid=ChIJsQd_yMaVj4ARrXw93nb4euo" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Leave a Google Review ↗</a>
      <a href="/reviews/" class="card-link testimonials-link">Read all reviews &rarr;</a>
      <a href="/reviews/#review-form" class="card-link testimonials-link">Share Your Story &amp; Photos &rarr;</a>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.testimonials-section').forEach((section) => {
    const track = section.querySelector<HTMLElement>('.testimonial-track');
    section.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) => {
      button.addEventListener('click', () => {
        const card = track?.querySelector<HTMLElement>('.testimonial-card');
        if (!track || !card) return;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        track.scrollBy({ left: Number(button.dataset.direction) * (card.offsetWidth + gap), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      });
    });
  });
</script>
<style>
  .testimonials-section { --color-star: var(--color-accent); background: var(--color-canvas); padding: var(--space-section-tight); border-top: 1px solid var(--color-border-default); }
  .testimonials-head { text-align: center; max-width: 760px; margin: 0 auto 48px; }
  .testimonials-head .section-lead { margin: 0 auto; }
  .slider-heading { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 18px; }
  .slider-heading p { margin: 0; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; }
  .slider-controls { display: flex; gap: 8px; }
  .slider-controls button { width: 44px; height: 44px; background: var(--color-surface-1); border: 1px solid var(--color-border-default); color: var(--color-text-strong); font-size: 1.3rem; cursor: pointer; }
  .slider-controls button:hover, .slider-controls button:focus-visible { border-color: var(--color-accent); }
  .testimonial-track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 3 * 20px) / 3.25); gap: 20px; overflow-x: auto; overscroll-behavior-inline: contain; scroll-snap-type: x mandatory; padding-bottom: 12px; scrollbar-width: thin; }
  .testimonial-card { scroll-snap-align: start; display: flex; flex-direction: column; min-width: 0; padding: 26px; background: var(--color-surface-1); border: 1px solid var(--color-border-default); border-radius: var(--radius-sm); }
  .testimonial-quote { color: var(--color-text-strong); line-height: 1.6; margin: 20px 0 24px; text-wrap: pretty; }
  .testimonial-attribution { display: flex; flex-direction: column; gap: 4px; margin-top: auto; color: var(--color-text-muted); font-size: .85rem; }
  .testimonial-attribution strong { color: var(--color-text-strong); font-size: 1rem; }
  .testimonials-actions { margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--color-border-default); display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  @media (max-width: 900px) { .testimonial-track { grid-auto-columns: 44%; } }
  @media (max-width: 600px) { .testimonial-track { grid-auto-columns: 86%; } .testimonial-card { padding: 22px; } }
</style>
