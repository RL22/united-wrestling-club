---
---

  <div class="modal-overlay" id="trialModal">
    <div class="modal-card">
      <button class="modal-close" id="modalCloseBtn">&times;</button>
      
      <div id="modalFormContainer">
        <div class="modal-brand-row">
          <img src="/live_site_content/assets/uwc_wrestlers.svg" alt="United Wrestling Club Official Emblem" class="modal-logo">
          <div>
            <span class="section-eyebrow eyebrow-tight">3-DAY MAT PASS • $15</span>
            <h3 class="modal-title">Step Onto the&nbsp;Mat</h3>
          </div>
        </div>
        <p class="modal-sub">Enter your details below to claim your 3 consecutive training sessions. Coach Naweed will reach out to confirm your gear and class time.</p>

        <form id="trialForm" action="https://formspree.io/f/mkjjyyep" method="POST" data-uwc-form="trial_pass" data-uwc-trial-form>
          <div class="form-group">
            <label class="form-label" for="v01-athlete">Athlete Full Name</label>
            <input type="text" id="v01-athlete" name="athlete_name" class="form-input" placeholder="e.g. Jordan Smith" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="v01-parent">Parent / Guardian Name (If Youth Athlete)</label>
            <input type="text" id="v01-parent" name="parent_name" class="form-input" placeholder="e.g. Michael Smith">
          </div>

          <div class="form-group">
            <label class="form-label" for="v01-phone">Phone Number (For SMS Confirmation)</label>
            <input type="tel" id="v01-phone" name="phone" class="form-input" placeholder="(510) 303-4869" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="v01-program">Target Program</label>
            <select id="v01-program" name="program" class="form-select" required>
              <option value="youth">Youth Wrestling Academy (Ages 5–13)</option>
              <option value="varsity">Varsity &amp; Scholastic Prep (Ages 14–18)</option>
              <option value="adult">Adult Wrestling &amp; Wrestle-Jitsu (18+)</option>
              <option value="openmat">Saturday Open Mat ($15 Drop-in)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="v01-source">How did you first find United Wrestling Club?</label>
            <select id="v01-source" name="self_reported_source" class="form-select" required>
              <option value="" disabled selected>Select one...</option>
              <option value="google_search">Google Search (Wrestling near me)</option>
              <option value="google_maps_reviews">Google Maps / 5-Star Reviews</option>
              <option value="friend_family_referral">UWC Family / Coach / Teammate Referral</option>
              <option value="school_tournament">High School / SCWAY Tournament</option>
              <option value="instagram_social">Instagram / YouTube / Social Media</option>
              <option value="drove_by_industrial_pkwy">Drove by Facility (Industrial Pkwy)</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="tcpa-consent-box">
            <label class="tcpa-checkbox-label" for="v01-sms-opt-in">
              <input type="checkbox" id="v01-sms-opt-in" name="sms_opt_in" value="true">
              <span>Text me my 3-Day Mat Pass confirmation, Suite C arrival instructions, and club updates from <strong>United Wrestling Club</strong>.</span>
            </label>
            <div class="tcpa-optout-note">
              Optional. Consent is not a condition of purchase. Msg &amp; data rates may apply. Msg frequency varies (up to 6 msgs/mo). Reply <strong>STOP</strong> to opt out at any time or <strong>HELP</strong> for help.
            </div>
          </div>

          <div class="tcpa-consent-box">
            <label class="tcpa-checkbox-label" for="v01-media-release">
              <input type="checkbox" id="v01-media-release" name="media_release" value="yes" checked>
              <span><strong>Media &amp; content notice.</strong> UWC films and photographs classes, open mats, and events for coaching and promotion on our website and social channels. Included by default. Uncheck to opt out.</span>
            </label>
          </div>

          <!-- Hidden First-Party Attribution & TCPA Consent Audit Fields (Auto-populated by uwc-attribution.js) -->
          <input type="hidden" name="uwc_lead_id" value="">
          <input type="hidden" name="ga_client_id" value="">
          <input type="hidden" name="initial_referrer" value="">
          <input type="hidden" name="initial_referring_domain" value="">
          <input type="hidden" name="initial_landing_page" value="">
          <input type="hidden" name="initial_utm_source" value="">
          <input type="hidden" name="initial_utm_medium" value="">
          <input type="hidden" name="initial_utm_campaign" value="">
          <input type="hidden" name="initial_channel" value="">
          <input type="hidden" name="initial_taxonomy" value="">
          <input type="hidden" name="last_utm_source" value="">
          <input type="hidden" name="last_utm_medium" value="">
          <input type="hidden" name="last_utm_campaign" value="">
          <input type="hidden" name="touch_count" value="">
          <input type="hidden" name="touch_path_json" value="">
          <input type="hidden" name="consent_timestamp_utc" value="">
          <input type="hidden" name="consent_source_url" value="">
          <input type="hidden" name="consent_disclosure_version" value="v1.0-2026-11">
          <input type="hidden" name="sms_opt_in_status" value="opted_out_or_unchecked">

          <button type="submit" class="btn btn-primary btn-accent-glow btn-block btn-trial-submit">
            Confirm $15 3-Day Pass
          </button>
          <p class="form-status" id="v01-trial-status" role="status" hidden></p>

          <div class="modal-fineprint">
            Your request goes to the UWC front desk. The waiver is completed on WrestlingIQ (Team #513). Reply STOP anytime to opt out of texts.
          </div>
        </form>
        <p class="modal-fineprint"><a href="/register/">Prefer a full page? Reserve on our booking page &rarr;</a></p>
      </div>

      <!-- Success State -->
      <div class="modal-success-state" id="modalSuccessState">
        <div class="success-icon">✓</div>
        <h3 class="modal-title modal-title--success">Pass Reserved!</h3>
        <p class="modal-sub modal-sub--tight" id="v01-success-sub">
          Coach Naweed has received your request. Complete your registration in WrestlingIQ or text Coach Naweed directly below.
        </p>
        <div class="pass-summary">
          <div><strong>Address:</strong> 30139 Industrial Pkwy SW Ste C, Hayward, CA</div>
          <div class="pass-summary-row"><strong>Locker Arrival:</strong> 15 minutes before scheduled class</div>
          <div class="pass-summary-row"><strong>Attire:</strong> T-shirt and gym shorts (no pockets)</div>
          <div class="pass-summary-row" id="v01-sms-status-row"><strong>SMS Status:</strong> Opted In (Reply STOP anytime to opt out)</div>
        </div>
        <a href="https://www.wrestlingiq.com/users/sign_up?paid_session_id=6327&amp;show_registration=true&amp;team_id=513" id="v01-wiq-btn" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-accent-glow btn-block btn-wiq">Complete in WrestlingIQ (Team #513) &nearr;</a>
        <button class="btn btn-outline btn-block" id="modalDoneBtn">Close</button>
      </div>
    </div>
  </div>

<style>
    .tcpa-consent-box {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      margin: 14px 0;
    }
    .tcpa-optout-note {
      font-size: 0.72rem;
      color: var(--color-text-muted);
      line-height: 1.55;
      margin-top: 8px;
      padding-left: 28px;
    }
    .success-icon {
      font-size: 3rem;
      color: var(--color-success);
      margin-bottom: 12px;
    }

.eyebrow-tight { margin-bottom: 2px; }
.btn-trial-submit { margin-top: 10px; padding: 16px; }
.btn-wiq { margin-bottom: 10px; }
.pass-summary {
  margin: 20px 0;
  padding: 16px;
  text-align: left;
  font-size: 0.82rem;
  background: var(--color-canvas);
  border-radius: var(--radius-sm);
}
.pass-summary-row { margin-top: 4px; }

  /* Cascade parity: global overrides for selectors used in this section */
